\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Bare susceptibility at finite $q$ for $V=V_c$, $\mu -V/2=8\,\mathrm  {meV}$ and $T=0.2\,\mathrm  {meV}$. Full four-band model (solid) and geometrically trivial model (dashed). (a) Small $q$: geometry turns the minimum at $q=0$ into a maximum. (b) Full range: the global maximum lies at $q\approx 0.28\,\mathrm  {nm}^{-1}$.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:finiteq}{{5}{7}{Bare susceptibility at finite $q$ for $V=V_c$, $\mu -V/2=8\meV $ and $T=0.2\meV $. Full four-band model (solid) and geometrically trivial model (dashed). (a) Small $q$: geometry turns the minimum at $q=0$ into a maximum. (b) Full range: the global maximum lies at $q\approx 0.28\nm ^{-1}$}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Character of the $q=0$ response at $V=V_c$. Orange: geometry-driven ferromagnetic fluctuation ($\chi _{e}<0<\chi _{\rm  mass}$). Brown: dispersion-driven ($\chi _{e}<0$, $\chi _{\rm  mass}<0$). Cream: $q=0$ is a minimum of $\chi ^0$.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:map}{{6}{7}{Character of the $q=0$ response at $V=V_c$. Orange: geometry-driven ferromagnetic fluctuation ($\chie <0<\chim $). Brown: dispersion-driven ($\chie <0$, $\chim <0$). Cream: $q=0$ is a minimum of $\chi ^0$}{figure.caption.9}{}}
