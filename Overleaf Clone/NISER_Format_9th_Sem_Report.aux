\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The monkey saddle. Dispersion $\varepsilon _3(\mathbf  {k})-V_c/2$ of the critical band at $V=V_c$ near $\mathbf  {k}=0$. The surface rises along three directions and falls along the three in between, the cubic shape $-Ak^3\cos 3\varphi $ of Eq.~\eqref  {eq:disp}. The Hessian vanishes at the centre, so the density of states diverges as $|E-E_c|^{-1/3}$ rather than logarithmically.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:monkey}{{1}{4}{The monkey saddle. Dispersion $\varepsilon _3(\bk )-V_c/2$ of the critical band at $V=V_c$ near $\bk =0$. The surface rises along three directions and falls along the three in between, the cubic shape $-Ak^3\cos 3\varphi $ of Eq.~\eqref {eq:disp}. The Hessian vanishes at the centre, so the density of states diverges as $|E-E_c|^{-1/3}$ rather than logarithmically}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The three saddle phases of the critical band. (a) $\delta =0.5$: minimum at $\mathbf  {k}=0$ (white) and three saddles (black). (b) $\delta =1.0$: monkey saddle (red). (c) $\delta =1.5$: maximum at $\mathbf  {k}=0$ (red), saddles rotated by $\pi /3$. Colour: $\varepsilon _3-V/2$ in meV, clipped at $\pm 2\,\mathrm  {meV}$. Axes: $k_{x,y}/k_*$. In each pair the right panel is a zoom to $|k|\le 0.3\,k_*$. The thick contour is the van Hove energy, and white circles mark the minivalley minima.}}{4}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:phases}{{2}{4}{The three saddle phases of the critical band. (a) $\delta =0.5$: minimum at $\bk =0$ (white) and three saddles (black). (b) $\delta =1.0$: monkey saddle (red). (c) $\delta =1.5$: maximum at $\bk =0$ (red), saddles rotated by $\pi /3$. Colour: $\varepsilon _3-V/2$ in meV, clipped at $\pm 2\meV $. Axes: $k_{x,y}/k_*$. In each pair the right panel is a zoom to $|k|\le 0.3\,k_*$. The thick contour is the van Hove energy, and white circles mark the minivalley minima}{figure.caption.4}{}}
