Cell[CellGroupData[{

Cell["7. Conclusions", "Section",ExpressionUUID->"c9f42738-c101-4305-b5c1-f5247ca2abf8"],

Cell[TextData[{
 StyleBox["Geometry at the critical point.",
  FontWeight->"Bold"],
 " At ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "c"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "70f68553-59cb-4d60-b6d9-0a21e3f3ff5c"],
 " the two interband channels cancel in the effective mass and in the Berry \
curvature but add in the quantum metric. The monkey saddle carries a large, \
almost purely metric geometry: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", " ", "\[TildeEqual]", " ", "5.4", " ", 
    SuperscriptBox[
     StyleBox[
      RowBox[{" ", "nm"}],
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d4fe02cf-5e2c-45ce-a994-85539e367243"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", 
     RowBox[{"x", "y"}]], " ", "\[TildeTilde]", " ", "0"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"3acd7da8-365a-49e2-9787-b16ed3f55971"],
 "."
}], "Item",ExpressionUUID->"aa845818-104e-468d-ba02-f70eb960c44a"],

Cell[TextData[{
 StyleBox["Near the van Hove energy the dispersion controls the sign.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ceec39ae-cd6f-4403-bddc-46686e7c406c"],
 " is large and changes sign at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", 
    StyleBox["vhs",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "af560ac5-8825-4d52-80ee-a6748ea1f5f5"],
 "; geometry only moves the edges of the ferromagnetic window."
}], "Item",ExpressionUUID->"d25a6f64-7d52-4306-b9b1-713120fd0888"],

Cell[TextData[{
 StyleBox["Geometry-driven windows exist.",
  FontWeight->"Bold"],
 " On the high-density side, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[Mu]", " ", "-", " ", "V", "/", "2", " ", "\[GreaterTilde]", " ", "4.2", 
    " ", 
    StyleBox[
     RowBox[{" ", "meV"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a96ed869-691f-4cca-ae23-6dcba3ebd056"],
 " at all biases, and at low temperature at the van Hove energy for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", " ", ">", " ", 
    SubscriptBox["V", "c"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0474d1d1-d634-442d-be73-d08143c3e162"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], " ", "<", " ", "0", " ", "<", " ", 
    SubscriptBox["\[Chi]", 
     StyleBox["mass",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4876503d-8899-43ab-bcc9-c7e6d2a68477"],
 "."
}], "Item",ExpressionUUID->"11eb2b19-d7de-4209-ab9a-9f8cf6d18b28"],

Cell[TextData[{
 StyleBox["The maximum is local.",
  FontWeight->"Bold"],
 " In the geometry-driven window the global maximum of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Chi]", "0"], "(", "q", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fc48f3f9-b621-4abd-8b25-fd807033211b"],
 " sits at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", " ", "\[TildeTilde]", " ", "0.28", " ", 
    SuperscriptBox[
     StyleBox[
      RowBox[{" ", "nm"}],
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "eef5a63f-66ed-4d82-897e-c93bbf907c3f"],
 ", so an RPA instability there would first develop at finite wavevector."
}], "Item",ExpressionUUID->"f38a0662-fa97-4482-bf0b-df9e2a122a9c"],

Cell[TextData[{
 StyleBox["Contrast with the singular saddle.",
  FontWeight->"Bold"],
 " There the metric diverges at a band touching and dominates. The monkey \
saddle is gapped, its metric stays finite, and geometry decides the sign only \
where the dispersion is nearly neutral."
}], "Item",ExpressionUUID->"65b73b51-2e5f-4458-8cba-854e69097fa0"],

