Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", " ", "=", " ", "0.5"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b1a68cd5-da94-4569-9c84-ee58807dc057"],
 ".",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "16c2eeb6-8d67-4211-a4bf-3bf4c5cb3610"],
 " is large and negative at all temperatures (minimum about -65 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["eV",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dbbedad9-ef14-4e6f-ba8e-3f302cc991a0"],
 " near 2 K), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "e"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"65befd40-5642-4db4-87a3-0ba7e653ef26"],
 " reaches -83 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["eV",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c8c1b878-0a3a-420a-94d9-315b94756c7e"],
 ". Strong ferromagnetic tendency, entirely dispersion driven."
}], "Item",ExpressionUUID->"9424b219-798f-48d4-865a-23589bf9fc79"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", " ", "=", " ", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"40a54f68-8095-459a-9545-44a8a1fa699d"],
 ".",
 StyleBox[" At the lowest temperature ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["mass",
      FontSlant->"Plain"]], " ", "=", " ", "+", "26"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a6e164e8-3de6-4d4c-adb9-393a2e9b321c"],
 " outweighs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["geom",
      FontSlant->"Plain"]], " ", "=", " ", "-", "14"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"dd8aafca-16a4-4d4f-aaa0-0bf736c7a5fe"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], " ", ">", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0767e8d1-ceab-4942-b069-de9a2023bf8c"],
 ". ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "29b6d1bd-8ff8-4546-9209-cab03801aa0d"],
 " changes sign near 2.5 K; geometry decides the sign only in a narrow \
interval around 2 K."
}], "Item",ExpressionUUID->"108abad1-0648-47a0-b715-71212cbb6bc9"],

