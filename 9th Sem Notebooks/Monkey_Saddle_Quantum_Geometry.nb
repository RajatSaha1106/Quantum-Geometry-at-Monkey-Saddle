Cell[CellGroupData[{

Cell["5.4 Direct test at finite q (Fig. 6)", "Subsection",ExpressionUUID->"95a3cbff-f88b-4f4b-885f-0c646657ac07"],

Cell[TextData[{
 "The GES is a statement about the curvature of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Chi]", "0"], "(", "q", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7ca8f53c-4d81-461c-92e4-97b3290d083b"],
 " at the origin. To test both the decomposition and its meaning we evaluate \
the bubble directly at finite ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c7b69acb-db8d-483a-bf77-7e1f4fbe7e6f"],
 " along ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1f5441fb-541a-45c5-b737-443efaabfa34"],
 ", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", " ", "=", " ", 
    SubscriptBox["V", "c"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5d19f4d0-4a2d-4d39-978d-20f7a6111d22"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", " ", "-", " ", "V", "/", "2", " ", "=", " ", "8", " ", 
    StyleBox[
     RowBox[{" ", "meV"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9c164d20-942e-4228-b189-bae658777584"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", " ", "=", " ", "0.2", " ", 
    StyleBox[
     RowBox[{" ", "meV"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "12c9b9e1-beba-499b-a087-570134a32590"],
 ", in two models:"
}], "Text",ExpressionUUID->"4b101991-d7f0-4109-83cc-a0a0f0eb7131"],

Cell[TextData[{
 "the ",
 StyleBox["full four-band",
  FontWeight->"Bold"],
 " model;"
}], "Item",ExpressionUUID->"6842937c-47bb-441b-b583-69e60aedd055"],

Cell[TextData[{
 "the ",
 StyleBox["geometrically trivial",
  FontWeight->"Bold"],
 " model: same band energies, overlaps replaced by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", 
    RowBox[{"n", "m"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e58a7712-0f76-4b75-860a-fd76e2dfdc5a"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["geom",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2e482324-a4a5-419d-b46d-9b3b96b0948a"],
 " by construction."
}], "Item",ExpressionUUID->"ae7b07e2-2bd3-4baa-a2d4-442bb9b6acb5"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "69df210a-9011-41c2-bcd4-23852f8ea18a"],
 " along ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6944c934-ce1d-4156-941e-375c73708df7"],
 " only the mirror ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "y"], " ", "\[RightArrow]", " ", "-", 
    SubscriptBox["k", "y"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9765dd8a-d083-4c21-a5e9-a12e4dd19bd5"],
 " survives, so the grid covers the upper half plane. Degenerate pairs use \
the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox["f", "\[Prime]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"705407eb-31c2-4b33-9145-38e226505d5c"],
 "."
}], "Text",ExpressionUUID->"ad0ae584-33f9-4eae-8225-dd6d607202a1"],

Cell["\<\
fermi[e_, mu_, t_] := (1 - Tanh[(e - mu)/(2 t)])/2

(* contribution of one k point: {full model, geometrically trivial model} *)
bubblePoint[kx_, ky_, q_, V_, mu_, t_] := Module[{em, um, ep, up, ov, fa, fb, \
ff},
  {em, um} = bands[kx - q/2, ky, V];
  {ep, up} = bands[kx + q/2, ky, V];
  ov = Abs[Conjugate[um].Transpose[up]]^2;       (* |<u_n,k-|u_m,k+>|^2 *)
  fa = fermi[em, mu, t];
  fb = fermi[ep, mu, t];
  ff = Table[
    If[Abs[em[[n]] - ep[[m]]] < 10.^-9,
     fa[[n]] (1 - fa[[n]])/t,
     -(fa[[n]] - fb[[m]])/(em[[n]] - ep[[m]])], {n, 4}, {m, 4}];
  {Total[ff ov, 2], Tr[ff]}]

(* half-plane grids: inner part up to 0.45 nm^-1, logarithmic outer part up \
to 40 nm^-1 *)
{kxIn, kyIn, wIn} = polarGrid[Table[0.45 i/8, {i, 0, 8}], 24, Pi];
{kxOut, kyOut, wOut} = polarGrid[Table[0.45 (40/0.45)^(i/6.), {i, 0, 6}], 6, \
Pi];

muq = Vc/2 + 0.008;  tq = 0.0002;

chiq[q_] :=
 wIn.Table[bubblePoint[kxIn[[i]], kyIn[[i]], q, Vc, muq, tq], {i, \
Length[kxIn]}] +
  wOut.Table[bubblePoint[kxOut[[i]], kyOut[[i]], q, Vc, muq, tq], {i, \
Length[kxOut]}]\
\>", "Input",
 CellLabel->
  "In[144]:=",ExpressionUUID->"28044558-ffee-433f-a017-d10c31729b52"],

Cell[CellGroupData[{

Cell["\<\
(* slowest cell of the notebook: 26 values of q, about 15 000 k points each \
(a few minutes) *)
qlist = Join[Table[0.01 i, {i, 0, 12}], Table[0.16 + 0.02 i, {i, 0, 12}]];
AbsoluteTiming[cq = Table[chiq[q], {q, qlist}];]\
\>", "Input",
 CellLabel->
  "In[156]:=",ExpressionUUID->"2fe6ae5f-6d52-41a1-a159-923e919d1888"],

Cell[BoxData[
 RowBox[{"{", 
