Cell[TextData[{
 "Reading the table: each off-centre point comes in three ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "44afc7bb-bfef-4f86-8c6d-d73b1087dc39"],
 " copies. A negative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "x"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1947b570-5c31-4c92-b418-b0b9d940a3c1"],
 " means the point sits on the rays ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[CurlyPhi]", " ", "=", " ", "\[Pi]", ",", " ", "\[PlusMinus]", " ", 
    "\[Pi]", "/", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "064977f9-6d27-4498-8d1a-2d6dba2870ad"],
 ". In every phase the Morse count (minima - saddles + maxima) equals one. \
The van Hove energy is the saddle energy:"
}], "Text",ExpressionUUID->"2ba80aa6-807c-499c-b1c0-d1a3e7f7f96a"],

Cell[CellGroupData[{

Cell["\<\
(* van Hove energy relative to V/2, in meV *)
evhs[del_] := Module[{V = del Vc, sad},
  sad = Select[criticalK[V], kind[hessian[#, 0, V]] == \"saddle\" &];
  If[Length[sad] == 0, 0., 1000 (eps3[First[sad], 0, V] - V/2)]]

Table[{del, evhs[del]}, {del, {0.5, 0.8, 1.0, 1.2, 1.5}}] // TableForm\
\>", "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"340d10fe-acb5-4389-b03a-841e91ed30aa"],

Cell[BoxData[
 TagBox[GridBox[{
    {"0.5`", "0.`"},
    {"0.8`", "0.`"},
    {"1.`", "0.`"},
    {"1.2`", "0.`"},
    {"1.5`", "0.`"}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[2.0999999999999996`]}, 
       Offset[0.27999999999999997`]}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}}],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{4.0036723028357167`*^9},
 CellLabel->
  "Out[49]//TableForm=",ExpressionUUID->"e27bb041-bd03-49a7-aabc-\
045d3f5ee538"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.4 The three saddle phases (Fig. 2)", "Subsection",ExpressionUUID->"c1d8264d-108f-47b1-a538-f7ed99fc606d"],

Cell[TextData[{
 "Contour maps of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "3"], " ", "-", " ", "V", "/", "2"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "189040ee-5662-4516-9b18-6d41606f8d2d"],
 " in meV (clipped at \[PlusMinus]2 meV), axes in units of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "*"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "395aeeca-db16-49bd-b322-b322ace40c00"],
 ". Left: full view. Right: zoom on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "k", "|", " ", "\[LessEqual]", " ", "0.3", " ", 
    SubscriptBox["k", "*"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"47f1c643-e690-4a73-bcdd-ddcbdc527014"],
 ". The thick contour is the van Hove energy. Black dots are saddles, white \
dots are minima, red marks the monkey saddle or the central maximum."
}], "Text",ExpressionUUID->"a1910ec1-1dba-48fb-aa61-0eaf10eed31a"],

Cell["\<\
cmapColors = {RGBColor[0.239, 0.110, 0.031], RGBColor[0.561, 0.278, 0.078],
   RGBColor[0.859, 0.471, 0.129], RGBColor[0.965, 0.714, 0.337], \
RGBColor[0.992, 0.941, 0.835]};
cmap[z_] := Blend[cmapColors, Clip[(z + 2)/4, {0, 1}]]

(* the three C3 copies of a point on the kx axis, in units of k* *)
c3pts[k_] := Table[{k Cos[a], k Sin[a]}/ks, {a, {0, 2 Pi/3, 4 Pi/3}}]

saddlePlot[del_, kmax_, r_] := Module[{V = del Vc, crit, types, ev, base, \
vhs, pts},
  crit = criticalK[V];
  types = Table[kind[hessian[k, 0, V]], {k, crit}];
  ev = evhs[del];
  base = ContourPlot[Clip[1000 (eps3[x ks, y ks, V] - V/2), {-2.1, 2.1}],
    {x, -kmax, kmax}, {y, -kmax, kmax},
    Contours -> Table[-1.95 + 0.15 i, {i, 0, 26}],
    ColorFunction -> cmap, ColorFunctionScaling -> False,
    ContourStyle -> Directive[GrayLevel[0.25], Thin],
    PlotPoints -> 50, MaxRecursion -> 1,
    PlotLegends -> BarLegend[{cmap, {-2, 2}}, LegendLabel -> \"E - V/2 \
(meV)\"],
    FrameLabel -> {\"kx/k*\", \"ky/k*\"}, ImageSize -> 380];
  vhs = ContourPlot[1000 (eps3[x ks, y ks, V] - V/2) == ev,
    {x, -kmax, kmax}, {y, -kmax, kmax},
    ContourStyle -> Directive[Thickness[0.006], cmapColors[[1]]], PlotPoints \
-> 60];
  pts = Table[
    {EdgeForm[Black],
     Which[types[[i]] == \"saddle\", Black, types[[i]] == \"minimum\", White, \
True, Red],
     If[crit[[i]] == 0, Disk[{0, 0}, r], Table[Disk[p, r], {p, \
c3pts[crit[[i]]]}]]},
    {i, Length[crit]}];
  Show[base, vhs, Graphics[pts]]]\
\>", "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"9d59d664-1828-4ca8-b417-51809adebfe5"],

Cell[TextData[{
 StyleBox["(a) ",
  FontWeight->"Bold"],
