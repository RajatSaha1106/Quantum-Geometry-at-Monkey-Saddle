Cell["References", "Subsection",ExpressionUUID->"05d88170-e1e6-46a3-aeed-dc5f5baf6a26"],

Cell["\<\
T. Kitamura, A. Daido and Y. Yanase, Spin-triplet superconductivity from \
quantum-geometry-induced ferromagnetic fluctuation, Phys. Rev. Lett. (2024); \
arXiv:2304.11536.\
\>", "Item",ExpressionUUID->"98ba6741-73d3-4b99-a9ac-238ede6eae8e"],

