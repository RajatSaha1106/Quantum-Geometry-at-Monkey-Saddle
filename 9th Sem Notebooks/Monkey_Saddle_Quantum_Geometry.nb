Cell[TextData[{
 StyleBox["Near the van Hove energy",
  FontWeight->"Bold"],
 " both components are tens of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["eV",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cbc43f2c-b9e8-476e-8c9c-004cfa07ef4d"],
 ". ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b2f61819-d03f-4302-86c1-87d494973d9a"],
 " changes sign at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", 
    StyleBox["vhs",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6694f78d-1e43-47b4-8a52-3ee2b6d6dcb6"],
 " and controls the sign of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "e"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1348632e-69e5-4a24-9640-1c10d2608de2"],
 ". The ferromagnetic window just below ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", 
    StyleBox["vhs",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8be5d5c7-814a-4fb3-9819-8ef98c02d1d1"],
 " is mostly dispersion driven; geometry only widens it by the thin orange \
strip at its upper edge."
}], "Item",ExpressionUUID->"fe6cd2fe-5c64-47da-aa16-e065b334e325"],

Cell[TextData[{
 StyleBox["High-density side.",
  FontWeight->"Bold"],
 " The components are ten times smaller. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c43f7cfb-cb6b-41c5-a0f5-dfbad1a56c02"],
 " stays positive, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["geom",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "76ac402d-3438-4373-b6c7-f80454c62bae"],
 " is negative and larger: from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[Mu]", " ", "-", " ", "V", "/", "2", " ", "\[TildeTilde]", " ", "4.2", 
    " ", 
    StyleBox[
     RowBox[{" ", "meV"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1a7a9f0b-1f52-4239-b35b-7ed00ce5d7fa"],
 " upward ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], " ", "<", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"293d84c8-0b63-4d9b-96a5-8ebcab9a9891"],
 " purely because of geometry, at all three biases."
}], "Item",ExpressionUUID->"637eab03-3679-40bd-9298-86c64692cac4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2 Temperature dependence at the van Hove energy (Fig. 4)", \
"Subsection",ExpressionUUID->"852de097-b6d0-47ff-ba48-7afac6324f73"],

Cell[TextData[{
 "The three components at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", " ", "=", " ", 
    SubscriptBox["E", 
     StyleBox["vhs",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f6948175-0cea-4e7e-9cc2-d61b71f51bc6"],
 " for the three saddle phases ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", " ", "=", " ", "0.5", ",", " ", "1", ",", " ", "1.5"}],
    TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9a2b4821-32c4-4623-82a3-00509eb4e286"],
 ", from 0.1 to 10 meV, i.e. 1.16 to 116 K. Over this range the thermal \
window reaches the valence band, only ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d973af82-8ea9-419d-a29c-53fca4ed968e"],
 " away, which is why all four bands carry full Fermi functions."
}], "Text",ExpressionUUID->"484a8707-691e-4b91-bdb2-ecf580e607dc"],

Cell["\<\
kB = 0.0861733;                                (* meV per kelvin *)
Tlist = Table[0.1*100^(i/23.), {i, 0, 23}];    (* 0.1 to 10 meV *)

Do[With[{ev = evhs[del]},
  tscan[del] = Table[ges[del, ev, T], {T, Tlist}]], {del, {0.5, 1.0, 1.5}}]

tempPlot[j_, name_] := ListLogLinearPlot[
  Table[Transpose[{Tlist/kB, tscan[del][[All, j]]}], {del, {0.5, 1.0, 1.5}}],
  Joined -> True, PlotMarkers -> Automatic,
  PlotStyle -> {Directive[cBlue, Thick], Directive[cBrown, Thick], \
Directive[cOrange, Thick]},
  Frame -> True, Axes -> False, GridLines -> {None, {0}}, PlotRange -> All,
  FrameLabel -> {\"T (K)\", Row[{name, \" (\", Superscript[\"eV\", -1], \
\")\"}]},
  PlotLabel -> Row[{name, \" at \[Mu] = \", Subscript[\"E\", \"vhs\"]}],
  PlotLegends -> Placed[{\"\[Delta] = V/Vc = 0.5\", \"\[Delta] = V/Vc = \
1.0\", \"\[Delta] = V/Vc = 1.5\"}, {Right, Bottom}],
  ImageSize -> 520]\
\>", "Input",
 CellLabel->
  "In[107]:=",ExpressionUUID->"9cd9c703-633a-46b7-b8f5-e8bcb2851077"],

Cell[TextData[{
 StyleBox["(a)",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["geom",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7176c53a-7457-4775-beb9-1a73aa3c26ea"]
}], "Text",ExpressionUUID->"c950a3ff-3d2f-403c-a09e-0df0079c45e1"],

Cell[CellGroupData[{

Cell["tempPlot[1, Subscript[\"\[Chi]\", \"geom\"]]", "Input",
 CellLabel->
