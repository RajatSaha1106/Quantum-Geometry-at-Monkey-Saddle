Cell[TextData[{
 "The dotted line in (a) is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Proportional]", " ", 
    SuperscriptBox["T", 
     RowBox[{"-", "1", "/", "3"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0ddd7c23-e9c3-471a-a446-a36c923da371"],
 ". The analytic result for the pure cubic saddle is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Chi]", "0"], "(", "0", ")", " ", "\[TildeEqual]", " ", 
    "0.0702", " ", 
    SuperscriptBox["A", 
     RowBox[{"-", "2", "/", "3"}]], " ", 
    SuperscriptBox["T", 
     RowBox[{"-", "1", "/", "3"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4dc9734b-13f8-433f-b65b-7520855182aa"],
 "; the prefactor is a product of a Beta function (density of states) and a \
thermal integral. Compare with the four-band numbers:"
}], "Text",ExpressionUUID->"97565e23-64a1-42e1-a82b-13c31ead54b8"],

Cell[CellGroupData[{

Cell["\<\
pref = N[Beta[1/2, 1/6]/(12 Pi^2) * 2 (2^(4/3) - 1) Gamma[2/3] Abs[Zeta[-1/3]]]

TableForm[
 Table[{T, pref A3^(-2/3) (0.001 T)^(-1/3), ges[1.0, 0, T][[4]]}, {T, {0.02, \
0.05, 0.1}}],
