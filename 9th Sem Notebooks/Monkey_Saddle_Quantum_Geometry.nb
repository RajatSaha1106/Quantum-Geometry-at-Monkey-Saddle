  "Out[158]=",ExpressionUUID->"1fd9ed94-93a3-4021-b261-d75f98846fb4"]
}, Open  ]],

Cell[TextData[{
 "Small-",
 Cell[BoxData[
  FormBox["q", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "88db5658-3a30-4a0d-9eac-98143fda1ab8"],
 " curvature of the two bubbles (a fit in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"51b4b452-dd2b-43f9-9e40-9dc9d847e8ed"],
 " to the first five points) against the GES prediction, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4db269a4-570e-4e4b-a6b9-e3dc0b4d6268"],
 " for the full model and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["mass",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b64fae34-fdcc-45d5-91e0-8db43879c4e7"],
 " for the trivial one:"
}], "Text",ExpressionUUID->"88c9e4cb-9b85-475b-a042-fb5063349792"],

Cell[CellGroupData[{

Cell["\<\
fitFull = Fit[Table[{qlist[[i]]^2, cq[[i, 1]]}, {i, 5}], {1, z, z^2}, z];
fitTriv = Fit[Table[{qlist[[i]]^2, cq[[i, 2]]}, {i, 5}], {1, z, z^2}, z];
s8 = ges[1.0, 8, 0.2];

TableForm[{{\"full four-band\", Coefficient[fitFull, z, 1], s8[[3]]/2},
  {\"geometrically trivial\", Coefficient[fitTriv, z, 1], s8[[2]]/2}},
 TableHeadings -> {None, {\"model\", \"curvature of the bubble\", \"GES \
prediction\"}}]\
\>", "Input",
 CellLabel->
  "In[159]:=",ExpressionUUID->"b589b557-bf0a-4d26-83dd-17418bc2a355"],

