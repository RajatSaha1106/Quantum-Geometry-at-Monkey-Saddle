Cell[CellGroupData[{

Cell["\<\
(* normalised curve chi0(q)/chi0(0), mirrored to negative q *)
sym[col_] := Module[{pts},
  pts = Table[{qlist[[i]], cq[[i, col]]/cq[[1, col]]}, {i, Length[qlist]}];
  Join[Reverse[Table[{-p[[1]], p[[2]]}, {p, Rest[pts]}]], pts]]

qPlot[qm_, yr_, title_] := ListLinePlot[{sym[1], sym[2]},
  PlotMarkers -> {Automatic, 6}, PlotStyle -> {Black, Directive[cBrown, \
Dashed]},
  PlotRange -> {{-qm, qm}, yr}, Frame -> True, Axes -> False,
  FrameLabel -> {\"qx (1/nm)\", \"\[Chi]0(q)/\[Chi]0(0)\"}, PlotLabel -> title,
  PlotLegends -> Placed[{\"full four-band\", \"geometrically trivial\"}, \
Below], ImageSize -> 480]

Row[{qPlot[0.12, {0.985, 1.025}, \"(a) small q\"], qPlot[0.40, {0.25, 1.2}, \
\"(b) full range\"]}]\
\>", "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"a9ec626d-299f-4944-be8f-f3db955ca956"],

