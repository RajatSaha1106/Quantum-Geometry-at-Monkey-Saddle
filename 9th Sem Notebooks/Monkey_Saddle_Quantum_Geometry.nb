Cell[CellGroupData[{

Cell["2. The monkey saddle", "Section",ExpressionUUID->"80c490fc-b365-4779-9e7f-ab5abc310023"],

Cell[CellGroupData[{

Cell["2.1 Effective dispersion", "Subsection",ExpressionUUID->"091d9507-0dfd-4f0c-a869-3783f5f89f4f"],

Cell[TextData[{
 "Eliminating the dimer orbitals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["B", "1"], ",", " ", 
    SubscriptBox["A", "2"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1f4bfaf6-2c0c-469e-ac8f-d270bfe50946"],
 " gives, to leading order,"
}], "Text",ExpressionUUID->"fb80439b-866a-4211-bfc9-301acc0e2193"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CurlyEpsilon]", "3"], "(", "k", ")", " ", "-", " ", 
   FractionBox["V", "2"], " ", "\[TildeEqual]", " ", "\[Alpha]", "(", "V", 
   ")", " ", 
   SuperscriptBox["k", "2"], " ", "-", " ", "A", " ", 
   SuperscriptBox["k", "3"], " ", "cos", " ", "3", "\[CurlyPhi]", " ", "+", 
   " ", "B", " ", 
   SuperscriptBox["k", "4"], " ", ",", "   ", " ", "\[Alpha]", "(", "V", ")", 
   " ", "=", " ", 
   FractionBox[
    SubsuperscriptBox["v", "3", "2"], "V"], " ", "-", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox["v", "2"], " ", "V"}], 
    SubsuperscriptBox["\[Gamma]", "1", "2"]]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"8b04cf33-bfe2-40fd-\
8721-298fac31c879"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8de09730-5684-4ae0-8f87-c91125e3c413"],
 " coefficient is a competition: direct trigonal-warping hopping to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7a7acd65-6852-4cae-b276-1d707882b0ee"],
 " pushes the band up, virtual hopping through the dimer pushes it down. The \
two cancel at the critical bias, where the cubic term fixes the shape:"
}], "Text",ExpressionUUID->"8459b652-06f6-49ef-a6e5-0ddce3af9c98"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["V", "c"], " ", "=", " ", 
   FractionBox[
    RowBox[{
     SubscriptBox["\[Gamma]", "1"], " ", 
     SubscriptBox["v", "3"]}], "v"], " ", "=", " ", "40", " ", 
   StyleBox[
    RowBox[{" ", "meV"}],
    FontSlant->"Plain"], " ", ",", "   ", " ", "A", " ", "=", " ", 
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["v", "3"]}], 
    SubsuperscriptBox["\[Gamma]", "1", "2"]], " ", ",", "   ", " ", "B", " ", 
   "=", " ", 
   FractionBox[
    SuperscriptBox["v", "5"], 
    RowBox[{
     SubsuperscriptBox["\[Gamma]", "1", "3"], " ", 
     SubscriptBox["v", "3"]}]], " ", ",", "   ", " ", 
   SubscriptBox["k", "*"], " ", "=", " ", 
   FractionBox["A", "B"], " ", "=", " ", "0.122", " ", 
   SuperscriptBox[
    StyleBox[
     RowBox[{" ", "nm"}],
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], " ", ",", "   ", " ", 
   SubscriptBox["E", "*"], " ", "=", " ", 
   FractionBox[
    SuperscriptBox["A", "4"], 
    SuperscriptBox["B", "3"]], " ", "=", " ", "6.40", " ", 
   StyleBox[
    RowBox[{" ", "meV"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"fc29a5e4-a7c1-4673-8088-139315e695a3"],

Cell[TextData[{
 "Throughout, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", " ", "\[Congruent]", " ", "V", "/", 
    SubscriptBox["V", "c"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b7c731cf-44e9-4c58-8a2d-498840a74516"],
 ". Quick check of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "(", "V", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9f6f530a-9d77-4a0f-9c12-f74213ff2c2a"],
 " against exact diagonalisation: along ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyPhi]", " ", "=", " ", "\[Pi]", "/", "6"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "23333d66-2562-4021-a7e1-809ac0fe828e"],
 " the cubic term vanishes, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[CurlyEpsilon]", "3"], " ", "-", " ", "V", "/", "2", ")", 
    "/", 
    SuperscriptBox["k", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"81263a51-56e3-4341-bb07-b2d809bebb1a"],
 " at small ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "49ca00f1-d9af-46b5-9b09-2d049bc048ea"],
 " is the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cbc778a6-9783-4961-ba7d-869e6804b025"],
 " coefficient."
}], "Text",ExpressionUUID->"db2a0bb3-bb96-4767-b92f-548d7822f302"],

Cell[CellGroupData[{

Cell["\<\
alpha[V_] := v3^2/V - v^2 V/g1^2

kt = 0.001;
TableForm[
 Table[{del, (eps3[kt Cos[Pi/6], kt Sin[Pi/6], del Vc] - del Vc/2)/kt^2, \
alpha[del Vc]},
  {del, {0.5, 0.8, 1.2, 1.5}}],
 TableHeadings -> {None, {\"\[Delta]\", \"k^2 coefficient, exact\", \
\"\[Alpha](V), formula\"}}]\
\>", "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"777ccd36-3fd8-4d24-b388-b879183779b1"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\<\"\[Delta]\"\>",
       HoldForm], 
      TagBox["\<\"k^2 coefficient, exact\"\>",
       HoldForm], 
      TagBox["\<\"\[Alpha](V), formula\"\>",
       HoldForm]},
     {"0.5`", "0.16241788159537807`", "0.16236150000000005`"},
     {"0.8`", "0.048744724045340915`", "0.04870845`"},
     {"1.2`", 
      RowBox[{"-", "0.03966377469175053`"}], 
      RowBox[{"-", "0.039688366666666655`"}]},
     {"1.5`", 
      RowBox[{"-", "0.09018094846574565`"}], 
      RowBox[{"-", "0.0902008333333333`"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[2.0999999999999996`]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   {None, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {
     None, {"\[Delta]", "k^2 coefficient, exact", 
       "\[Alpha](V), formula"}}]]]], "Output",
 CellChangeTimes->{4.003672287565717*^9},
 CellLabel->
  "Out[33]//TableForm=",ExpressionUUID->"cee6cb06-619d-43a5-a7af-\
3d97bcd914bb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2 The shape of the monkey saddle (Fig. 1)", "Subsection",ExpressionUUID->"92eb5d03-614c-4b52-b557-0e6df75859c4"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", " ", "=", " ", 
    SubscriptBox["V", "c"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"23029b83-d1f7-47b8-9056-cddef43ad12f"],
 " the surface rises along three directions and falls along the three in \
between. The Hessian vanishes at the centre, so the density of states \
diverges as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "E", " ", "-", " ", 
    SubscriptBox["E", "c"], 
    SuperscriptBox["|", 
     RowBox[{"-", "1", "/", "3"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"60464d83-574f-4eaf-aeb6-5b2c2f9c6abe"],
 " instead of logarithmically. First the ideal cubic form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SuperscriptBox["k", "3"], " ", "cos", " ", "3", "\[CurlyPhi]", " ", "=", 
    " ", "-", "(", 
    SuperscriptBox["x", "3"], " ", "-", " ", "3", " ", "x", " ", 
    SuperscriptBox["y", "2"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5fe29048-76e3-43b9-bfde-5901f742e195"],
 ", then the actual band 3 of the four-band model in units of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "*"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9eef0731-8eb7-4759-8ae3-46857c7247ae"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "*"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5b231199-a9ab-40c6-8825-74efcd91d02e"],
 "."
}], "Text",ExpressionUUID->"144ed640-3b4e-48df-a855-e1c9cb9fc51f"],

Cell["Plot3D[-(x^3 - 3 x y^2), {x, -0.5, 0.5}, {y, -0.5, 0.5}]", "Input",ExpressionUUID->"8876a153-11c9-4920-827c-eab864b585da"],

Cell[CellGroupData[{

Cell["\<\
Plot3D[(eps3[x ks, y ks, Vc] - Vc/2)/Es, {x, -0.5, 0.5}, {y, -0.5, 0.5},
 AxesLabel -> {\"kx/k*\", \"ky/k*\", \"(\[CurlyEpsilon]3 - Vc/2)/E*\"}, \
PlotPoints -> 30]\
\>", "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"83e572e7-a4ed-4267-9c88-fcd6e50e948c"],

