(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["\<\
Quantum geometry and ferromagnetic fluctuations at the monkey saddle of \
biased bilayer graphene\
\>", "Title",ExpressionUUID->"fc4755f4-fa33-4bc6-a84e-35b63e682620"],

Cell["\<\
Working notebook: every figure of my report, computed from the four-band model\
\>", "Subtitle",
 CellChangeTimes->{{4.003891087104269*^9, 
  4.0038910908772354`*^9}},ExpressionUUID->"79e9f580-0794-44df-b518-\
7d9dcb656af4"],

Cell["Rajat Shuvra Saha \[LongDash] School of Physical Sciences, NISER", \
"Text",ExpressionUUID->"a6185740-a5d3-43c3-a5c4-f298d3137dac"],

Cell[TextData[{
 "At a critical interlayer bias ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "c"], " ", "\[TildeEqual]", " ", "40", " ", 
    StyleBox[
     RowBox[{" ", "meV"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4c093d6a-bb9e-4ff7-8fac-01c6ce7c189a"],
 " the three van Hove saddles of the lowest conduction band of Bernal bilayer \
graphene merge into one ",
 StyleBox["monkey saddle",
  FontWeight->"Bold"],
 ", a higher-order van Hove singularity. Following Kitamura, Daido and \
Yanase, this notebook asks whether the quantum geometry of that band favours \
ferromagnetic fluctuations. The quantity to watch is the ",
 StyleBox["generalized electric susceptibility",
  FontWeight->"Bold"],
 " (GES) ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "e"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8d52f7c4-b288-4b67-b0d1-1eea498015c2"],
 ", the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"66dddb0a-6777-4029-900e-e5923eb3c61b"],
 " curvature of the bare susceptibility, split into a geometric part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["geom",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "39b68377-154e-4c93-98ec-f11ce4f061d5"],
 " and an effective-mass part ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3bc5fd9e-3595-4507-9041-01d8750c4226"],
 "."
}], "Text",ExpressionUUID->"21bb5351-f07f-4af0-80e5-b12a12b6ba74"],

Cell[TextData[StyleBox["Plan of the talk",
 FontWeight->"Bold"]], "Text",ExpressionUUID->"320cb33d-8855-4741-ad64-f8b8d19a7e63"],

Cell["1. Model: the four-band Hamiltonian", "Item",ExpressionUUID->"a911f517-c317-46e1-aa40-a9ea477d3e86"],

Cell["\<\
2. The monkey saddle: shape, critical points, the three saddle phases (Figs. \
1, 2, Table I)\
\>", "Item",ExpressionUUID->"c730ad8f-e895-4e75-a738-2399352c55a4"],

Cell["3. Quantum geometry of the critical band (Table II)", "Item",ExpressionUUID->"4d4cf24d-1ea3-4ed9-98c9-1233a3d5137f"],

Cell["\<\
4. Generalized electric susceptibility: formulas and numerical method\
\>", "Item",ExpressionUUID->"3dbeb4ec-e3bf-4b55-a4d7-ef02c5d7a5e0"],

Cell["\<\
5. Results: chemical potential, temperature, finite q, phase diagram (Figs. 3 \
to 7)\
\>", "Item",ExpressionUUID->"4c00555e-033b-459e-a793-bd18a73c2309"],

Cell["\<\
6. Benchmark: the singular saddle point of Kitamura et al. (Fig. 8)\
\>", "Item",ExpressionUUID->"b5ed5bf0-eb82-4d13-af8d-40c7423b1248"],

Cell["7. Conclusions", "Item",ExpressionUUID->"aa6de601-272b-4d86-8bea-d4f61a1be558"],

Cell[TextData[{
 StyleBox["How to run.",
  FontWeight->"Bold"],
 " Evaluate the cells from top to bottom (Evaluation > Evaluate Notebook). \
Sections 1 to 3 are instant. The band data of Section 4 and the finite-",
 Cell[BoxData[
  FormBox["q", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "46e1f736-1dbc-4409-b73b-56007b55f14e"],
 " scan of Section 5.4 are the slow cells; each one says so in a comment. \
Units: energies in eV, momenta in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["nm",
     FontSlant->"Plain"], 
    RowBox[{"-", "1"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c085316e-de47-4c06-a4d7-1d6ab11c5630"],
 "; ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fab02833-0d9a-4d83-91ba-96141996ae4d"],
 " and ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c3e6cb7f-e215-49e7-b3c9-748dae661ec3"],
 " are quoted in meV, with ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5624c2c2-00f5-4390-9f48-6390f0c236f3"],
 " measured from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "/", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "45355cfb-dfab-4e2c-8acb-f3b52f7467eb"],
 "."
}], "Text",ExpressionUUID->"65be6363-3109-4b8c-83f1-7c138812486f"],

Cell["\<\
ClearAll[\"Global`*\"]

cBlue = RGBColor[0.227, 0.431, 0.647];
cBrown = RGBColor[0.545, 0.271, 0.075];
cOrange = RGBColor[0.851, 0.478, 0.110];
biasColors = {cBlue, cBrown, cOrange};\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"dbd1b5f4-c6c6-49a2-b145-505e1c406fd2"],

Cell[CellGroupData[{

Cell["1. Model", "Section",ExpressionUUID->"fa5b4a66-7e5f-4827-8d28-74c56ed3ac26"],

Cell[TextData[{
 "Four-band continuum Hamiltonian of Bernal bilayer graphene near valley K, \
in the basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["A", "1"], ",", " ", 
    SubscriptBox["B", "1"], ",", " ", 
    SubscriptBox["A", "2"], ",", " ", 
    SubscriptBox["B", "2"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"25ad5726-eddc-45fd-aaa5-d1669f8c1f6a"],
 ", with interlayer bias ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a7180620-6aa8-4347-ac25-de125505e4ef"],
 " (McCann and Koshino):"
}], "Text",ExpressionUUID->"fa04de7d-3a46-4b72-8016-f6f1895d9c77"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "(", "k", ")", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"V", "/", "2"}], 
       RowBox[{"v", " ", 
        SuperscriptBox["\[Pi]", "\[Dagger]"]}], "0", 
       RowBox[{
        SubscriptBox["v", "3"], " ", "\[Pi]"}]},
      {
       RowBox[{"v", " ", "\[Pi]"}], 
       RowBox[{"V", "/", "2"}], 
       SubscriptBox["\[Gamma]", "1"], "0"},
      {"0", 
       SubscriptBox["\[Gamma]", "1"], 
       RowBox[{"-", "V", "/", "2"}], 
       RowBox[{"v", " ", 
        SuperscriptBox["\[Pi]", "\[Dagger]"]}]},
      {
       RowBox[{
        SubscriptBox["v", "3"], " ", 
        SuperscriptBox["\[Pi]", "\[Dagger]"]}], "0", 
       RowBox[{"v", " ", "\[Pi]"}], 
       RowBox[{"-", "V", "/", "2"}]}
     }], ")"}], " ", ",", "   ", " ", "\[Pi]", " ", "=", " ", 
   SubscriptBox["k", "x"], " ", "+", " ", "i", " ", 
   SubscriptBox["k", "y"]}], TraditionalForm]], "DisplayFormula",ExpressionUUI\
D->"02ce5d21-f033-411f-b129-58af9f7b179b"],

Cell[TextData[{
 "Parameters: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", " ", "=", " ", "0.658", " ", 
    StyleBox[
     RowBox[{" ", 
      RowBox[{"eV", " ", "nm"}]}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a0353ed4-e745-4cc0-a14c-acae6b7a3409"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "1"], " ", "=", " ", "0.40", " ", 
    StyleBox[
     RowBox[{" ", "eV"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "12e3a0cd-46a3-4f45-af3e-e8a7e9298cba"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "3"], " ", "=", " ", "0.1", " ", "v"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d41aea9c-d506-423c-8685-e4dee7044cef"],
 ". The Hamiltonian is ",
 StyleBox["linear in k",
  FontWeight->"Bold"],
 ", so the velocity matrices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], " ", "H"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2cf8ec59-2940-4a24-8e56-bbc9851cb781"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], " ", "H"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"acf2f1aa-293b-4eff-8d62-f586e39295c9"],
 " are constant. Every band derivative used later is then an exact finite sum \
over the four states."
}], "Text",ExpressionUUID->"2e7ba846-51d5-4aba-b3ad-e297136fdb91"],

Cell[CellGroupData[{

Cell["\<\
v = 0.658;  g1 = 0.40;  v3 = 0.1 v;

(* constant velocity matrices dH/dkx and dH/dky *)
dHx = {{0, v, 0, v3}, {v, 0, 0, 0}, {0, 0, 0, v}, {v3, 0, v, 0}};
dHy = {{0, -I v, 0, I v3}, {I v, 0, 0, 0}, {0, 0, 0, -I v}, {-I v3, 0, I v, \
0}};

h0[V_] := {{V/2, 0, 0, 0}, {0, V/2, g1, 0}, {0, g1, -V/2, 0}, {0, 0, 0, -V/2}};
ham[kx_, ky_, V_] := h0[V] + kx dHx + ky dHy;

MatrixForm[ham[kx, ky, V]]\
\>", "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"a51b13d5-702b-4aba-9d24-d9ab39eb4015"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox["V", "2"], 
      RowBox[{
       RowBox[{"0.658`", " ", "kx"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"0.`", "\[VeryThinSpace]", "+", 
          RowBox[{"0.658`", " ", "\[ImaginaryI]"}]}], ")"}], " ", "ky"}]}], 
      "0", 
      RowBox[{
       RowBox[{"0.06580000000000001`", " ", "kx"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"0.`", "\[VeryThinSpace]", "+", 
          RowBox[{"0.06580000000000001`", " ", "\[ImaginaryI]"}]}], ")"}], 
        " ", "ky"}]}]},
     {
      RowBox[{
       RowBox[{"0.658`", " ", "kx"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"0.`", "\[VeryThinSpace]", "+", 
          RowBox[{"0.658`", " ", "\[ImaginaryI]"}]}], ")"}], " ", "ky"}]}], 
      FractionBox["V", "2"], "0.4`", "0"},
     {"0", "0.4`", 
      RowBox[{"-", 
       FractionBox["V", "2"]}], 
      RowBox[{
       RowBox[{"0.658`", " ", "kx"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"0.`", "\[VeryThinSpace]", "+", 
          RowBox[{"0.658`", " ", "\[ImaginaryI]"}]}], ")"}], " ", "ky"}]}]},
     {
      RowBox[{
       RowBox[{"0.06580000000000001`", " ", "kx"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"0.`", "\[VeryThinSpace]", "+", 
          RowBox[{"0.06580000000000001`", " ", "\[ImaginaryI]"}]}], ")"}], 
        " ", "ky"}]}], "0", 
      RowBox[{
       RowBox[{"0.658`", " ", "kx"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"0.`", "\[VeryThinSpace]", "+", 
          RowBox[{"0.658`", " ", "\[ImaginaryI]"}]}], ")"}], " ", "ky"}]}], 
      RowBox[{"-", 
       FractionBox["V", "2"]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{4.003672259546035*^9},
 CellLabel->
  "Out[16]//MatrixForm=",ExpressionUUID->"03c008bd-bc16-474b-8ff2-\
6fffa68e43a0"]
}, Open  ]],

Cell[TextData[{
 "Eigenvalues come out of Eigensystem in no useful order, so we sort them \
once and for all. ",
 StyleBox["bands",
  FontWeight->"Bold"],
 " returns the four energies in ascending order together with the matching \
eigenvectors (one per row). Band 3 is the lowest conduction band; at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cccabaae-87b3-4944-96f9-8be178ebb237"],
 " it is the pure ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "aa973881-ae8b-4480-a858-9ea14967a047"],
 " orbital at energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "/", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "11ea0962-8270-4688-847b-25a816d7fa5e"],
 "."
}], "Text",ExpressionUUID->"cb6d7100-86c7-42c1-9fea-ddac9642d9e6"],

Cell["\<\
bands[kx_, ky_, V_] := Module[{vals, vecs, ord},
  {vals, vecs} = Eigensystem[ham[kx, ky, V]];
  ord = Ordering[vals];
  {vals[[ord]], vecs[[ord]]}]

band[n_, kx_?NumericQ, ky_?NumericQ, V_] := bands[kx, ky, V][[1, n]]
eps3[kx_, ky_, V_] := band[3, kx, ky, V]\
\>", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"aab5ef44-178e-4906-97ed-99001eb503e5"],

Cell[CellGroupData[{

Cell["\<\
(* characteristic scales *)
Vc = g1 v3/v;                    (* critical bias *)
A3 = 2 v^3/g1^2;                 (* cubic coefficient A *)
B4 = v^5/(g1^3 v3);              (* quartic coefficient B *)
ks = A3/B4;  Es = A3^4/B4^3;     (* crossover scales k* and E* *)

{1000 Vc, ks, 1000 Es}           (* 40 meV, 0.122 nm^-1, 6.40 meV *)\
\>", "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"4770ff41-ccce-4b75-91fa-78f44c59abe4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "40.00000000000001`", ",", "0.12158054711246205`", ",", 
   "6.400000000000006`"}], "}"}]], "Output",
 CellChangeTimes->{4.0036722685387955`*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"c7fba731-d935-49b7-b86e-6052140a8349"]
}, Open  ]],

