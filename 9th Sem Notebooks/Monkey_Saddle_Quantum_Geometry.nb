Cell[TextData[{
 StyleBox["Band data at one k point.",
  FontWeight->"Bold"],
 " For each of the four bands: energy, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "K"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "85c15043-7d0c-4ca6-a69d-7348809f3cca"],
 ", ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9ab7e1fa-7bdf-44a5-94c6-7c0cdd82e402"],
 " and inverse mass, straight from the formulas of Section 4.1."
}], "Text",ExpressionUUID->"c85ee7e8-5db2-42c3-a049-e5d8ec551ab7"],

Cell[CellGroupData[{

Cell["\<\
bandData[kx_, ky_, V_] := Module[{e, U, vx, vy, vv, de},
  {e, U} = bands[kx, ky, V];
  vx = Conjugate[U].dHx.Transpose[U];
  vy = Conjugate[U].dHy.Transpose[U];
  vv = Abs[vx]^2 + Abs[vy]^2;
  de = Table[If[n == m, 10.^15, e[[n]] - e[[m]]], {n, 4}, {m, 4}];    (* \
10^15 removes m = n *)
  {e, Total[vv/de^2, {2}], Total[-vv/de^3, {2}], Total[vv/de, {2}]}]

bandData[0.05, 0.02, Vc] // TableForm\
\>", "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"dce4799a-53a0-4924-9deb-015cbd5e80b9"],

