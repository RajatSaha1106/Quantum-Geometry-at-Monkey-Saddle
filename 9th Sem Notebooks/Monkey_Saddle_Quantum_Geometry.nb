Cell[TextData[{
 StyleBox["Message.",
  FontWeight->"Bold"],
 " At ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "c"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "55332192-48eb-404f-8025-f60adbbe9824"],
 " the band carries a large quantum metric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", " ", "=", " ", "5.44", " ", 
    SuperscriptBox[
     StyleBox[
      RowBox[{" ", "nm"}],
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f6b57346-4cf7-4a82-8ba7-2e12f0055876"],
 ", half of it from the remote dimer bands, and almost no Berry curvature (",
 Cell[BoxData[
  FormBox["\[CapitalOmega]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c3bb8a7a-002f-4405-b91b-59cee91ca626"],
 " changes sign at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", " ", "=", " ", "0.995", " ", 
    SubscriptBox["V", "c"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0ef5dd8a-d5e9-4229-965b-2462d6754ba0"],
 "). The geometry of the monkey saddle is metric dominated, and the metric is \
exactly what enters the GES."
}], "Text",ExpressionUUID->"59e375a1-5dcc-4bc5-a589-9b6dc29f7ebe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Generalized electric susceptibility", "Section",ExpressionUUID->"e9e816c5-7c98-484e-bca2-4e4975dafeb9"],

Cell[CellGroupData[{

Cell["4.1 Definition and decomposition", "Subsection",ExpressionUUID->"c852f668-4270-4d7e-8ebc-98c91a0debc7"],

Cell[TextData[{
 "Bare spin susceptibility, per spin and valley, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "\[PlusMinus]"], " ", "=", " ", "k", " ", 
    "\[PlusMinus]", " ", "q", "/", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"49e29b8a-10e6-40db-b752-6a5dad45483d"],
 ":"
}], "Text",ExpressionUUID->"ac44fc2a-4183-4ce0-91e2-d922d08ed05b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox["\[Chi]", "0"], "(", "q", ")", " ", "=", " ", "-", " ", 
   SubscriptBox["\[Sum]", 
    RowBox[{"n", " ", "m"}]], " ", "\[Integral]", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "2"], " ", "k"}], 
    RowBox[{"(", "2", "\[Pi]", 
     SuperscriptBox[")", "2"]}]], " ", 
   FractionBox[
    RowBox[{"f", "(", 
     SubscriptBox["\[CurlyEpsilon]", 
      RowBox[{"n", ",", 
       SubscriptBox["k", "-"]}]], ")", " ", "-", " ", "f", "(", 
     SubscriptBox["\[CurlyEpsilon]", 
      RowBox[{"m", ",", 
       SubscriptBox["k", "+"]}]], ")"}], 
    RowBox[{
     SubscriptBox["\[CurlyEpsilon]", 
      RowBox[{"n", ",", 
       SubscriptBox["k", "-"]}]], " ", "-", " ", 
     SubscriptBox["\[CurlyEpsilon]", 
      RowBox[{"m", ",", 
       SubscriptBox["k", "+"]}]]}]], " ", "|", "\[LeftAngleBracket]", " ", 
   SubscriptBox["u", 
    RowBox[{"n", ",", 
     SubscriptBox["k", "-"]}]], " ", "|", " ", 
   SubscriptBox["u", 
    RowBox[{"m", ",", 
     SubscriptBox["k", "+"]}]], " ", "\[RightAngleBracket]", 
   SuperscriptBox["|", "2"]}], TraditionalForm]], "DisplayFormula",ExpressionU\
UID->"ba0deb85-8bbb-4606-b3c5-4a265dec8a2f"],

Cell["The GES is its curvature at the origin:", "Text",ExpressionUUID->"8566324f-4534-453b-a4fc-537fbd497d38"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Chi]", "e"], " ", "\[Congruent]", " ", 
   SubsuperscriptBox["\[PartialD]", 
    SubscriptBox["q", "x"], "2"], " ", 
   SuperscriptBox["\[Chi]", "0"], "(", "q", ")", " ", 
   SubscriptBox["|", 
    RowBox[{"q", "=", "0"}]], " ", ",", "   ", " ", 
   SuperscriptBox["\[Chi]", "0"], "(", "q", ")", " ", "\[TildeEqual]", " ", 
   SuperscriptBox["\[Chi]", "0"], "(", "0", ")", " ", "(", "1", " ", "-", " ", 
   SuperscriptBox["\[ScriptL]", "2"], " ", 
   SuperscriptBox["q", "2"], ")", " ", ",", "   ", " ", 
   SuperscriptBox["\[ScriptL]", "2"], " ", "=", " ", "-", " ", 
   FractionBox[
    SubscriptBox["\[Chi]", "e"], 
    RowBox[{"2", " ", 
     SuperscriptBox["\[Chi]", "0"], "(", "0", ")"}]]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"d54273f2-603d-416e-\
9147-d34d678dad56"],

Cell[TextData[{
 "A negative ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "e"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"49a72141-2dfe-448e-9418-89e45e79aa4a"],
 " means ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"21093dcb-e897-4159-95fc-cfd9e06ce7a1"],
 " is a maximum of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Chi]", "0"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e579dcec-29a3-4e0a-85a4-1f8d8a35fb6e"],
 ". Within RPA the Stoner instability then appears first in the uniform \
channel: the paramagnet has ",
 StyleBox["ferromagnetic fluctuations",
  FontWeight->"Bold"],
 ". Expanding to order ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8f2ebb74-006b-4871-9cc3-0d2584e9e818"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], " ", "=", " ", 
    SubscriptBox["\[Chi]", 
     StyleBox["geom",
      FontSlant->"Plain"]], " ", "+", " ", 
    SubscriptBox["\[Chi]", 
     StyleBox["mass",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9c750958-5c65-4fe7-a03e-aaeb141a0d6c"],
 " with"
}], "Text",ExpressionUUID->"c17d42d9-f531-49dc-b96f-3a2977435086"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Chi]", 
    StyleBox["geom",
     FontSlant->"Plain"]], " ", "=", " ", "2", " ", 
   SubscriptBox["\[Sum]", "n"], " ", "\[Integral]", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "2"], " ", "k"}], 
    RowBox[{"(", "2", "\[Pi]", 
     SuperscriptBox[")", "2"]}]], " ", "[", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox["f", "\[Prime]"], "(", 
     SubscriptBox["\[CurlyEpsilon]", "n"], ")"}], "2"], " ", 
   SubsuperscriptBox["g", "K", "n"], " ", "+", " ", "f", "(", 
   SubscriptBox["\[CurlyEpsilon]", "n"], ")", " ", 
   SubscriptBox["X", "n"], " ", "]", " ", ",", "   ", " ", 
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], " ", "=", " ", "-", "2", " ", 
   SubscriptBox["\[Sum]", "n"], " ", "\[Integral]", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "2"], " ", "k"}], 
    RowBox[{"(", "2", "\[Pi]", 
     SuperscriptBox[")", "2"]}]], " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox["f", 
      RowBox[{"\[Prime]", "\[Prime]"}]], "(", 
     SubscriptBox["\[CurlyEpsilon]", "n"], ")"}], "12"], " ", 
   SubsuperscriptBox["m", "n", 
    RowBox[{"-", "1"}]]}], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"3f49d1ed-f7ab-4b33-b116-1568b212bdd6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["g", "K", "n"], " ", "=", " ", 
   SubscriptBox["\[Sum]", 
    RowBox[{"m", " ", "\[NotEqual]", " ", "n"}]], " ", 
   FractionBox[
    RowBox[{"|", 
     SubsuperscriptBox["v", 
      RowBox[{"n", "m"}], "x"], 
     SuperscriptBox["|", "2"], " ", "+", " ", "|", 
     SubsuperscriptBox["v", 
      RowBox[{"n", "m"}], "y"], 
     SuperscriptBox["|", "2"]}], 
    RowBox[{"(", 
     SubscriptBox["\[CurlyEpsilon]", "n"], " ", "-", " ", 
     SubscriptBox["\[CurlyEpsilon]", "m"], 
     SuperscriptBox[")", "2"]}]], " ", ",", "   ", " ", 
   SubscriptBox["X", "n"], " ", "=", " ", 
   SubscriptBox["\[Sum]", 
    RowBox[{"m", " ", "\[NotEqual]", " ", "n"}]], " ", 
   FractionBox[
    RowBox[{"|", 
     SubsuperscriptBox["v", 
      RowBox[{"n", "m"}], "x"], 
     SuperscriptBox["|", "2"], " ", "+", " ", "|", 
     SubsuperscriptBox["v", 
      RowBox[{"n", "m"}], "y"], 
     SuperscriptBox["|", "2"]}], 
    RowBox[{"(", 
     SubscriptBox["\[CurlyEpsilon]", "m"], " ", "-", " ", 
     SubscriptBox["\[CurlyEpsilon]", "n"], ")", "(", 
     SubscriptBox["\[CurlyEpsilon]", "n"], " ", "-", " ", 
     SubscriptBox["\[CurlyEpsilon]", "m"], 
     SuperscriptBox[")", "2"]}]], " ", ",", "   ", " ", 
   SubsuperscriptBox["m", "n", 
    RowBox[{"-", "1"}]], " ", "=", " ", 
   SubscriptBox["\[Sum]", 
    RowBox[{"m", " ", "\[NotEqual]", " ", "n"}]], " ", 
   FractionBox[
    RowBox[{"|", 
     SubsuperscriptBox["v", 
      RowBox[{"n", "m"}], "x"], 
     SuperscriptBox["|", "2"], " ", "+", " ", "|", 
     SubsuperscriptBox["v", 
      RowBox[{"n", "m"}], "y"], 
     SuperscriptBox["|", "2"]}], 
    RowBox[{
     SubscriptBox["\[CurlyEpsilon]", "n"], " ", "-", " ", 
     SubscriptBox["\[CurlyEpsilon]", "m"]}]]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"bea89666-47f9-4a09-\
b4b7-1694b78bcf27"],

Cell["Two observations organise everything that follows:", "Text",ExpressionUUID->"8bfe8bbe-df6a-4149-a258-88373057168e"],

Cell[TextData[{
 "The Fermi-surface metric term is always negative because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["f", "\[Prime]"], " ", "\[LessEqual]", " ", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "21876cac-b4b6-4738-afc1-8fa0ed0cbc75"],
 ". Geometry always pushes towards ferromagnetism at the Fermi surface; the \
Fermi-sea term ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "99a87676-ab78-4ea5-a52b-9965a63f5f9c"],
 " can partly compensate."
}], "Item",ExpressionUUID->"0546948a-be81-41c0-b758-974a46672c17"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["f", 
     RowBox[{"\[Prime]", "\[Prime]"}]], "(", "\[CurlyEpsilon]", " ", "-", " ",
     "\[Mu]", ")"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b1663b35-24f9-4af8-8dba-c6c0d4871d1f"],
 " is odd about ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a6e3f8c4-e03e-4dcd-89e4-e6c635081109"],
 ", so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d260dfba-1efc-4d93-9dc1-a778a29e2372"],
 " measures the imbalance of band curvature just below and just above ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a4dbfdde-8d87-4a47-88cd-44d9c2f3db15"],
 ". Near a saddle it is large and changes sign as ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9728650d-3030-48b6-b71c-60dd341c47c5"],
 " crosses ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", 
    StyleBox["vhs",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d805c8b3-2721-4231-8fa4-0df731ddf1f7"],
 "."
}], "Item",ExpressionUUID->"efccb103-2ae3-496c-b7b9-16bde0915255"],

Cell[TextData[{
 "We call a ferromagnetic fluctuation ",
 StyleBox["geometry driven",
  FontWeight->"Bold"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], " ", "<", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"296ac4e1-ceb4-40dd-8297-56a65faf315c"],
 " but ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["mass",
      FontSlant->"Plain"]], " ", ">", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"382ff26c-5c13-4488-be18-6e1e2d3d0762"],
 ": the dispersion alone would make ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"651636ff-d7ed-4275-8ad2-021e6897e675"],
 " a minimum."
}], "Text",ExpressionUUID->"0abb646c-e762-4be0-8ca8-c0467bf87bce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Numerical method", "Subsection",ExpressionUUID->"0f568ea0-3483-49b8-9f9e-8ad35559916e"],

Cell[TextData[{
 StyleBox["Gauss\[Dash]Legendre nodes.",
  FontWeight->"Bold"],
 " The radial integrals use 64-point Gauss\[Dash]Legendre panels. Nodes and \
weights come from the eigenvalues and eigenvectors of the Jacobi matrix \
(Golub\[Dash]Welsch), mapped to the interval [0, 1]."
}], "Text",ExpressionUUID->"1f796e86-c566-490b-b250-0b47ea1ad125"],

Cell[CellGroupData[{

Cell["\<\
ngl = 64;
beta = Table[n/Sqrt[4. n^2 - 1], {n, 1, ngl - 1}];
jac = Table[If[Abs[i - j] == 1, beta[[Min[i, j]]], 0.], {i, ngl}, {j, ngl}];
{xgl, vgl} = Eigensystem[jac];

xg = (xgl + 1)/2;          (* nodes on [0, 1] *)
wg = vgl[[All, 1]]^2;      (* weights on [0, 1] *)

{Total[wg], wg.xg^2, wg.xg^9}     (* should be 1, 1/3, 1/10 *)\
\>", "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"b56525fd-9cd6-4246-b460-ffe515fb8ff2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.`", ",", "0.33333333333333354`", ",", "0.10000000000000023`"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0036724099050217`*^9},
 CellLabel->"Out[77]=",ExpressionUUID->"5fb3c100-6947-4523-b309-61ec8ca00809"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Polar grid.",
  FontWeight->"Bold"],
 " The integrands have the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "485f9d48-f04f-45b2-a843-f01fe4a301b1"],
 " and mirror symmetry of the band, so it is enough to integrate over the 60\
\[Degree] wedge ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "0", " ", "<", " ", "\[CurlyPhi]", " ", "<", " ", "\[Pi]", "/", "3"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f43e5206-f952-4499-89bb-142dd3b8f8fc"],
 " and multiply by six. The function below builds a polar grid on any wedge \
and scales the weights so that they cover the whole plane, including the \
measure ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["d", "2"], " ", "k", "/", "(", "2", "\[Pi]", 
    SuperscriptBox[")", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7d8d0bf8-7965-4ea2-873c-28c5c59213b2"],
 "."
}], "Text",ExpressionUUID->"1a300cfb-6af1-41a0-bcb5-90580df1288e"],

Cell[CellGroupData[{

Cell["\<\
polarGrid[edges_, nphi_, phimax_] := Module[{kr, wr, phis},
  kr = Flatten[Table[edges[[i]] + (edges[[i + 1]] - edges[[i]]) xg, {i, \
Length[edges] - 1}]];
  wr = Flatten[Table[(edges[[i + 1]] - edges[[i]]) wg, {i, Length[edges] - \
1}]];
  phis = Table[(j - 0.5) phimax/nphi, {j, nphi}];
  {Flatten[Outer[Times, kr, Cos[phis]]],
   Flatten[Outer[Times, kr, Sin[phis]]],
   Flatten[Outer[Times, wr kr, Table[2 Pi/nphi, {nphi}]]]/(4 Pi^2)}]

(* inner grid: 12 panels up to 0.36 and 4 more up to 0.60 nm^-1, 48 angles in \
the wedge *)
edges = Join[Table[0.03 i, {i, 0, 12}], Table[0.36 + 0.06 i, {i, 1, 4}]];
{kxs, kys, ws} = polarGrid[edges, 48, Pi/3];

{Length[kxs], Total[ws] 4 Pi, 0.6^2}     (* number of points; area check: the \
last two agree *)\
\>", "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"39031924-2339-44c6-bfbf-93d71b949e90"],

