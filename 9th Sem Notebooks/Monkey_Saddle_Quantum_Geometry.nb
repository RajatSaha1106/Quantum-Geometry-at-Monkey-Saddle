 "Peak sharpness ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ScriptL]", "2"], " ", "=", " ", "-", 
    SubscriptBox["\[Chi]", "e"], " ", "/", " ", "2", 
