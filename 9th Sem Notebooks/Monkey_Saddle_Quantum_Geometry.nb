Cell[TextData[{
 "The mass term is positive while ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["geom",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6bde2d49-6f59-4764-8227-2fca4bbb7a38"],
 " is negative and grows rapidly as the gap closes. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "=", " ", "0.17"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0b2336ea-017f-49f7-912b-fa1b4eb64cba"],
 " the two nearly cancel and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], " ", "<", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"5d219b22-132e-4cd4-8c71-1c6c64f15010"],
 " only above ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", " ", "\[TildeTilde]", " ", "0.01"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c5ec7e93-8ced-478c-969b-46376e42bf72"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "=", " ", "0.02"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e9b52b67-6b03-4d2c-9147-80bbf091b2b0"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "e"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"13bd72d0-7666-416a-9ba2-1834993f8855"],
 " is clearly negative at all temperatures shown: the ferromagnetic tendency \
is geometry driven, as found by Kitamura et al."
}], "Text",ExpressionUUID->"04e9f9cd-4a4d-497c-a425-7646601d4d05"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.4 Lifting the band touching", "Subsection",ExpressionUUID->"8f3a5c18-f8b2-4a77-a3c9-7a434fa7db74"],

Cell[TextData[{
 "The same two bands as the gap parameter is varied; at zero the bands touch \
at the singular saddle. Drag the slider. (To explore another parameter set, \
change ",
 StyleBox["pars",
  FontWeight->"Bold"],
 " in Section 6.1 and re-evaluate this section.)"
}], "Text",ExpressionUUID->"f2481175-198f-4def-a4b2-6f3ee22383c0"],

Cell[CellGroupData[{

Cell["\<\
Manipulate[
 Plot3D[{eSing[1, p, q, dy], eSing[-1, p, q, dy]}, {p, -0.8, 0.8}, {q, -0.8, \
0.8},
  PlotStyle -> {Directive[Blue, Opacity[0.8]], Directive[Red, Opacity[0.9]]},
  Mesh -> None, PlotRange -> {-0.5, 1.8}, ViewPoint -> {0, -3, 0.4},
  AxesLabel -> {\"px\", \"py\", \"Energy\"},
  PlotLabel -> Row[{\"Degeneracy lifting: \[Delta]y = \", NumberForm[dy, {4, \
3}],
     \"     Gap = \", NumberForm[2 dy, {4, 3}]}],
  ImageSize -> 500],
 {{dy, 0.17, \"\[Delta]y\"}, 0, 0.3}]\
\>", "Input",
 CellLabel->
  "In[235]:=",ExpressionUUID->"3c35615f-676f-48b1-bbef-f9f8133e8c97"],

