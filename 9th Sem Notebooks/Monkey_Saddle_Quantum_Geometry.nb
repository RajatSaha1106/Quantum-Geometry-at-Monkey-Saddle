Cell[TextData[{
 "Temperature scan exactly at band touching (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "=", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8e256f99-101e-4404-ab7f-73178cf67540"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"11c7f69f-5ea3-43e9-a9f9-295ef7b2316a"],
 "). The only scale left is ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f12cc6f7-6567-4c24-93ad-67051ef2830b"],
 ", so each curve is close to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "T"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4553831f-e09f-443d-8446-d9e4920aa910"],
 ":"
}], "Text",ExpressionUUID->"dad3d4ca-89ba-4bcc-8ed3-76154c4f75d9"],

Cell[CellGroupData[{

Cell["\<\
Ttouch = Join[{0.005, 0.0075, 0.01, 0.0125, 0.015, 0.0175}, Table[0.005 i, \
{i, 4, 20}]];
touch = Table[gesSing[0, T, 0], {T, Ttouch}];

ListLinePlot[{Transpose[{Ttouch, touch[[All, 1]]}], Transpose[{Ttouch, \
touch[[All, 2]]}],
  Transpose[{Ttouch, touch[[All, 3]]}]},
 PlotMarkers -> {Automatic, 7}, PlotStyle -> {Red, Blue, Black},
 PlotRange -> {-2.6, 2.2}, Frame -> True, Axes -> False, GridLines -> {None, \
{0}},
 FrameLabel -> {\"Temperature T\", \"Susceptibility curvature\"},
 PlotLabel -> \"Susceptibility curvature versus temperature\",
 PlotLegends -> {Subscript[\"\[Chi]\", \"geom\"], Subscript[\"\[Chi]\", \
\"mass\"], Subscript[\"\[Chi]\", \"e\"]},
 ImageSize -> 520]\
\>", "Input",
 CellLabel->
  "In[236]:=",ExpressionUUID->"e3309831-301b-4807-acb5-25cfd5e6f9cb"],

