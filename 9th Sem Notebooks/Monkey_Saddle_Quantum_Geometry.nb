Cell["\<\
(* position and height of the global maximum of the full bubble *)
Last[SortBy[Table[{qlist[[i]], cq[[i, 1]]/cq[[1, 1]]}, {i, Length[qlist]}], \
Last]]\
\>", "Input",ExpressionUUID->"b16ebdc2-7473-4aa8-9a01-1fea443896fb"],

Cell[TextData[{
 StyleBox["(a) Small q.",
  FontWeight->"Bold"],
 " With geometry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a9517928-c2bc-4323-87f4-e35ed30aa12e"],
 " is a maximum; without it, a minimum. The curvatures agree with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ef75b308-0721-42a9-8735-856ffd7644c5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["mass",
      FontSlant->"Plain"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"471d485e-d9c7-4669-9024-2de6439443ce"],
 ", an independent confirmation of the decomposition."
}], "Item",ExpressionUUID->"1c5503b2-d448-415c-98d3-4259ae09b7e7"],

Cell[TextData[{
 StyleBox["(b) Full range.",
  FontWeight->"Bold"],
 " The maximum at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a59dd05e-e9a2-4aa6-b0f3-8d72d9c7004f"],
 " is only ",
 StyleBox["local",
  FontWeight->"Bold"],
 ". The bubble has its global maximum at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", " ", "\[TildeTilde]", " ", "0.28", " ", 
    SuperscriptBox[
     StyleBox[
      RowBox[{" ", "nm"}],
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5526e62c-9bad-487e-a0ab-5b00d3fe9068"],
 ", about 15% above ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Chi]", "0"], "(", "0", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"074f333e-724b-4e0e-a560-32db2458d068"],
 ". Within RPA an instability at this filling would first appear at finite \
wavevector."
}], "Item",ExpressionUUID->"98db5b5a-7fc4-4090-be9c-a9d90f5e66dc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.5 Where ferromagnetic fluctuations live (Fig. 7)", "Subsection",ExpressionUUID->"266b49e7-aafb-450a-986b-fd01b75a91d3"],

Cell[TextData[{
 "Every point of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[Mu]", ",", " ", "T", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2b58ab4b-1997-46e8-ae1c-ab763602357b"],
 " plane at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", " ", "=", " ", 
    SubscriptBox["V", "c"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1d8de405-f7a6-49ea-86e1-b547cd101d77"],
 " is classified by the signs of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "e"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ea035b35-5415-480f-96dc-ba1eb103913d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "badaddc6-9edf-4693-b2b5-9aef12eef7c1"],
 "."
}], "Text",ExpressionUUID->"6c90eb37-dd49-43fa-8757-f569dae02ecf"],

Cell[CellGroupData[{

Cell["\<\
phaseColors = {RGBColor[0.984, 0.961, 0.910], RGBColor[0.804, 0.718, 0.604], \
RGBColor[0.898, 0.541, 0.180]};

(* 1: no FM fluctuation, 2: FM dispersion-driven, 3: FM geometry-driven *)
classify[del_, m_, T_] := Module[{s = ges[del, m, T]},
  Which[s[[3]] >= 0, 1, s[[2]] < 0, 2, True, 3]]

Tmap = Table[0.1*10^(i/14.), {i, 0, 14}];

phasePanel[mus_, title_] := Module[{dm, dl, col},
  dm = mus[[2]] - mus[[1]];
  dl = Log10[Tmap[[2]]/Tmap[[1]]];
  Graphics[
   Table[col = phaseColors[[classify[1.0, m, T]]];
    {col, EdgeForm[col],
     Rectangle[{m - dm/2, Log10[T] - dl/2}, {m + dm/2, Log10[T] + dl/2}]}, \
{T, Tmap}, {m, mus}],
   Frame -> True, AspectRatio -> 0.6, PlotLabel -> title,
   FrameLabel -> {\"\[Mu] - V/2 (meV)\", \"T (meV)\"},
   FrameTicks -> {{{{-1, \"0.1\"}, {Log10[0.2], \"0.2\"}, {Log10[0.5], \
\"0.5\"}, {0, \"1\"}}, None},
     {Automatic, None}}, ImageSize -> 480]]

Column[{
  Row[{phasePanel[Table[-0.7 + 1.9 i/60, {i, 0, 60}], \"near the monkey \
saddle\"],
    phasePanel[Table[2. + 10 i/41, {i, 0, 41}], \"high-density side\"]}],
  SwatchLegend[phaseColors,
   {\"no FM fluctuation (\[Chi]e > 0)\", \"FM, dispersion-driven\", \"FM, \
geometry-driven\"},
   LegendLayout -> \"Row\"]}, Alignment -> Center]\
\>", "Input",
 CellLabel->
  "In[190]:=",ExpressionUUID->"bbd3ebe7-8550-4624-8c21-5df8cf298fc1"],

