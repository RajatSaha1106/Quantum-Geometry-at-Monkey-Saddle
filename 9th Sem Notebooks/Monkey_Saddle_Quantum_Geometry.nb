  "InlineFormula",ExpressionUUID->"e02c9662-2ad0-4505-a5f4-0b5fde47eaae"],
 ".",
 StyleBox[" ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "e"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"256e4a35-34e3-46f3-a14f-b37232363c5f"],
 " is negative over the whole range. Below about 5 K, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["mass",
      FontSlant->"Plain"]], " ", ">", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"79d80034-4fe3-40df-baba-7746efa45918"],
 " while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], " ", "<", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6946e72b-8e46-4a84-a1aa-e00f4a81f3a3"],
 ": above ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "c"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e1878d6b-9a86-4f7c-ae26-8627196d581e"],
 " the low-temperature ferromagnetic tendency is geometry driven."
}], "Item",ExpressionUUID->"5c318a81-f06d-4722-a27a-5aac64f2ae69"],

Cell[TextData[{
 "In all three cases ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["geom",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c3f20a48-66a5-4074-b2f2-43fee2534b01"],
 " turns positive at high temperature (near 16, 34 and 63 K), because thermal \
occupation of the valence band makes the positive Fermi-sea term dominate."
}], "Item",ExpressionUUID->"551cb8b0-a117-4e12-ad53-1ac4779df7c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3 Strength and robustness (Fig. 5)", "Subsection",ExpressionUUID->"e7de0868-a375-4dd0-be0b-2e44f7199d0e"],

Cell[TextData[{
 StyleBox["(a)",
  FontWeight->"Bold"],
 " At the van Hove energy the uniform susceptibility ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Chi]", "0"], "(", "0", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cb032491-2c30-4475-a9ec-8f9d51036651"],
 " should follow the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", 
    RowBox[{"-", "1", "/", "3"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cac8c863-c083-41e1-ade6-48338f764d5f"],
 " law of the monkey saddle. ",
 StyleBox["(b)",
  FontWeight->"Bold"],
 " At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", " ", "-", " ", "V", "/", "2", " ", "=", " ", "8", " ", 
    StyleBox[
     RowBox[{" ", "meV"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ae4b568e-4f36-4397-9216-1544ed76ae73"],
 ", deep in the high-density window, the full ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "e"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"20c8ad4e-beab-4af2-8f9e-3e6cd6ecbc93"],
 " is compared with the dispersion-only value ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", 
    StyleBox["mass",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "79d00b77-8a35-4473-85c2-de794ebcf04a"],
 "."
}], "Text",ExpressionUUID->"143054f7-a188-4671-88ea-352c3c8ce994"],

Cell[CellGroupData[{

Cell["\<\
Tlow = Table[0.02*50^(i/22.), {i, 0, 22}];      (* 0.02 to 1 meV *)
Thigh = Table[0.1*10^(i/16.), {i, 0, 16}];      (* 0.1 to 1 meV *)

chi0curves = Table[
   With[{ev = evhs[del]}, Table[{T, ges[del, ev, T][[4]]}, {T, Tlow}]], {del, \
{0.8, 1.0, 1.2}}];
nu0 = ges[1.0, 0, 0.02][[4]];

figA = Show[

   ListLogLogPlot[chi0curves, Joined -> True, PlotMarkers -> {Automatic, 6},
    PlotStyle -> biasColors, Frame -> True,
    FrameLabel -> {\"T (meV)\", \"\[Chi]0(q = 0)  (1/eV nm^2)\"},
    PlotLabel -> \"(a) uniform susceptibility, \[Mu] = Evhs\",
    PlotLegends -> Placed[{\"V = 0.8 Vc\", \"V = 1 Vc\", \"V = 1.2 Vc\"}, \
{Right, Top}],
    ImageSize -> 480],
   LogLogPlot[1.12 nu0 (T/0.02)^(-1/3), {T, 0.02, 1}, PlotStyle -> \
Directive[Gray, Dotted]]];

ges8 = Table[Table[ges[del, 8, T], {T, Thigh}], {del, {0.8, 1.0, 1.2}}];

figB = ListLogLinearPlot[
   Join[Table[Transpose[{Thigh, ges8[[j, All, 3]]}], {j, 3}],
    Table[Transpose[{Thigh, ges8[[j, All, 2]]}], {j, 3}]],
   Joined -> True, PlotMarkers -> {Automatic, 6},
   PlotStyle -> Join[biasColors, Table[Directive[c, Dashed], {c, biasColors}]],
   PlotRange -> {-1, 2.2}, Frame -> True, Axes -> False, GridLines -> {None, \
{0}},
   FrameLabel -> {\"T (meV)\", \"GES (1/eV)\"}, PlotLabel -> \"(b) \[Mu] - \
V/2 = 8 meV\",
   PlotLegends -> {\"0.8 Vc: full \[Chi]e\", \"1 Vc: full \[Chi]e\", \"1.2 \
Vc: full \[Chi]e\",
     \"0.8 Vc: dispersion only\", \"1 Vc: dispersion only\", \"1.2 Vc: \
dispersion only\"},
   ImageSize -> 480];

Row[{figA, figB}]\
\>", "Input",
 CellChangeTimes->{{4.003672463795909*^9, 4.003672465146896*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"9f93ba22-486e-41f8-8a2b-b9451ed5a19b"],

