Cell[TextData[{
 "Near the monkey saddle the dispersion-driven region dominates, and the \
geometry-driven region is a thin band along its boundary that moves to higher \
",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "40067771-f2e9-4c86-a345-ffac61b8baf6"],
 " as ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bbf71bb2-7310-4452-b472-1c7f87b64d39"],
 " grows. On the high-density side the geometry-driven region is large and \
sharply bounded at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[Mu]", " ", "-", " ", "V", "/", "2", " ", "\[TildeTilde]", " ", "4.2", 
    " ", 
    StyleBox[
     RowBox[{" ", "meV"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fd7050c8-7880-4fe7-9d6d-c9198ca3e4f7"],
 "."
}], "Text",ExpressionUUID->"0cc7b990-68dd-4b10-a01e-2f32178eadd4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Benchmark: the singular saddle point", "Section",ExpressionUUID->"afb1cb04-cc01-488c-b25b-e1cf363d7467"],

Cell["\<\
As a check of the method we reproduce the setting of Kitamura et al.: a \
two-band model with a singular saddle at a quadratic band touching,\
\>", "Text",ExpressionUUID->"68f650d4-a54b-40a4-895e-f5d6e2a8a0c0"],

Cell[BoxData[
 FormBox[
  RowBox[{"H", "(", "p", ")", " ", "=", " ", 
   FractionBox[
    SuperscriptBox["p", "2"], 
    RowBox[{"2", " ", "M"}]], " ", 
   SubscriptBox["\[Sigma]", "0"], " ", "+", " ", 
   FractionBox[
    RowBox[{
     SubscriptBox["p", "x"], " ", 
     SubscriptBox["p", "y"]}], 
    SubscriptBox["M", 
     RowBox[{"x", "y"}]]], " ", 
   SubscriptBox["\[Sigma]", "x"], " ", "+", " ", "\[CapitalDelta]", " ", 
   SubscriptBox["\[Sigma]", "y"], " ", "+", " ", 
   FractionBox[
    RowBox[{
     SubsuperscriptBox["p", "x", "2"], " ", "-", " ", 
     SubsuperscriptBox["p", "y", "2"]}], 
    RowBox[{"2", " ", 
     SubscriptBox["M", 
      RowBox[{"x", "x"}]]}]], " ", 
   SubscriptBox["\[Sigma]", "z"], " ", ",", "   ", " ", 
   FractionBox["1", "M"], " ", "=", " ", "1", " ", ",", "   ", " ", 
   FractionBox["1", 
    SubscriptBox["M", 
     RowBox[{"x", "x"}]]], " ", "=", " ", "0.5", " ", ",", "   ", " ", 
   FractionBox["1", 
    SubscriptBox["M", 
     RowBox[{"x", "y"}]]], " ", "=", " ", "1.5"}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"88afcbe1-0544-4e16-\
83fe-38de32d897cf"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "=", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"65302778-1999-4067-b557-d76509dcdc53"],
 " the lower band has a singular saddle where the metric diverges as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SuperscriptBox["p", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d5064f12-ccb6-4302-8dac-af6382594801"],
 ". A finite ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2de86b3a-0a74-44ac-95ce-0d473573d0b4"],
 " opens a gap ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[CapitalDelta]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7ff1658b-fc18-4d6d-b37b-657d37b55811"],
 ", regularises the metric and splits the singularity into four ordinary \
saddles at energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "s"], " ", "=", " ", "-", "\[CapitalDelta]", " ", 
    SqrtBox[
     RowBox[{"1", " ", "-", " ", 
      SubsuperscriptBox["M", 
       RowBox[{"x", "y"}], "2"], "/", 
      SuperscriptBox["M", "2"]}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a76cd2ac-12da-4cb4-8efa-d9da010da24e"],
 "."
}], "Text",ExpressionUUID->"4736972b-1b46-4f65-95e1-6ffe2fb12602"],

Cell[CellGroupData[{

Cell["6.1 Bands (Fig. 8a)", "Subsection",ExpressionUUID->"2da91976-ab8f-4e68-b229-a8497314a1b5"],

Cell[CellGroupData[{

Cell["\<\
pars = {1, 1/2, 3/2};       (* 1/M, 1/Mxx, 1/Mxy *)

(* s = +1 upper band, s = -1 lower band;  gp = Delta *)
eSing[s_, p_, q_, gp_] := pars[[1]] (p^2 + q^2)/2 +
  s Sqrt[(pars[[3]] p q)^2 + gp^2 + (pars[[2]] (p^2 - q^2)/2)^2]

eSaddle[gp_] := -gp Sqrt[1 - (pars[[1]]/pars[[3]])^2]
eSaddle[0.17]\
\>", "Input",
 CellLabel->
  "In[200]:=",ExpressionUUID->"456b2a36-ae48-4055-b9c6-a0e2aaf5b981"],

Cell[BoxData[
 RowBox[{"-", "0.1267105187249881`"}]], "Output",
 CellChangeTimes->{4.0036726482519703`*^9},
 CellLabel->
  "Out[206]=",ExpressionUUID->"2c392ebb-78b9-4444-8523-394c3d3df5ba"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Row[{
  Plot3D[{eSing[1, p, q, 0.17], eSing[-1, p, q, 0.17]}, {p, -0.8, 0.8}, {q, \
-0.8, 0.8},
   PlotStyle -> {Directive[Opacity[0.6], RGBColor[0.6, 0.8, 1.]], Orange},
   AxesLabel -> {\"px\", \"py\", \"E\"}, ImageSize -> 430],
  Plot[{eSing[1, p/Sqrt[2], p/Sqrt[2], 0.17], eSing[-1, p/Sqrt[2], p/Sqrt[2], \
0.17],
    eSing[1, p, 0, 0.17], eSing[-1, p, 0, 0.17]}, {p, -0.8, 0.8},
   PlotStyle -> {Directive[cBlue, Thick], Directive[cOrange, Thick],
     Directive[cBlue, Dashed], Directive[cOrange, Dashed]},
   PlotRange -> {-0.3, 0.9}, Frame -> True, FrameLabel -> {\"p\", \"E\"},
   Epilog -> {Arrowheads[{-0.03, 0.03}], Arrow[{{0, -0.17}, {0, 0.17}}],
     Text[Style[\"2\[CapitalDelta]\", 14], {0.07, 0}]},
   PlotLegends -> Placed[{\"upper, along px = py\", \"lower, along px = py\",
      \"upper, along px\", \"lower, along px\"}, {Left, Top}],
   ImageSize -> 430]}]\
\>", "Input",
 CellLabel->
  "In[207]:=",ExpressionUUID->"096a7293-cb47-4a4b-ad21-1157badb35f0"],

