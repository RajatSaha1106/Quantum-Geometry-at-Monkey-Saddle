  "InlineFormula",ExpressionUUID->"3c304184-5c66-4d12-9a53-7f4a042e6cd9"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", " ", "-", " ", "V", "/", "2", " ", "=", " ", "8", " ", 
    StyleBox[
     RowBox[{" ", "meV"}],
