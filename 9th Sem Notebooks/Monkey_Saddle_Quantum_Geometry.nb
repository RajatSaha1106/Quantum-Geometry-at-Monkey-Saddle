    TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2d3a720e-5a49-4852-b190-805d72f63bbe"],
 ". Top row: near the van Hove energy (dashed vertical line). Bottom row: the \
high-density side. Shading marks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", "e"], " ", "<", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fbc66099-89d0-421f-87b6-ef295c9022af"],
 ": orange where the ferromagnetic fluctuation is geometry driven (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Chi]", 
     StyleBox["mass",
      FontSlant->"Plain"]], " ", ">", " ", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0d41f1b4-2deb-47a4-a3d6-75b0947313ed"],
 "), grey where it is dispersion driven."
}], "Text",ExpressionUUID->"79bcc1a7-1149-4a32-af45-8c76960e124d"],

Cell["\<\
cShadeGeo = RGBColor[0.965, 0.788, 0.541];
cShadeDisp = RGBColor[0.851, 0.784, 0.706];

muPanel[del_, mus_, yr_, vline_] := Module[{s, dm, shade},
  s = Table[ges[del, m, 0.1], {m, mus}];
  dm = mus[[2]] - mus[[1]];
  shade = Table[
    If[s[[i, 3]] < 0,
     {If[s[[i, 2]] > 0, cShadeGeo, cShadeDisp],
      Rectangle[{mus[[i]] - dm/2, yr[[1]]}, {mus[[i]] + dm/2, yr[[2]]}]},
     {}], {i, Length[mus]}];
  ListLinePlot[{Transpose[{mus, s[[All, 1]]}], Transpose[{mus, s[[All, 2]]}],
    Transpose[{mus, s[[All, 3]]}]},
   PlotStyle -> {Directive[cOrange, Thickness[0.006]],
     Directive[cBrown, Thickness[0.006], Dashed], Directive[Black, \
Thickness[0.009]]},
   PlotRange -> {{First[mus], Last[mus]}, yr}, Prolog -> shade,
   Frame -> True, Axes -> False,
   GridLines -> {vline, {0}}, GridLinesStyle -> Directive[Gray, Dashed],
   PlotLabel -> Row[{\"V = \", del, \" Vc\"}],
   FrameLabel -> {\"\[Mu] - V/2 (meV)\", \"GES (1/eV)\"}, AspectRatio -> 0.8]]\
\>", "Input",
 CellLabel->"In[96]:=",ExpressionUUID->"9e2fd1f8-017d-467e-b1d4-edfc622dfffb"],

Cell[CellGroupData[{

Cell["\<\
muNear = Table[-0.7 + 0.02 i, {i, 0, 95}];
muHigh = Table[2. + i/6., {i, 0, 60}];

top = Table[muPanel[del, muNear, {-60, 45}, {evhs[del]}], {del, {0.8, 1.0, \
1.2}}];
bottom = Table[muPanel[del, muHigh, {-3.5, 3.5}, {}], {del, {0.8, 1.0, 1.2}}];

Column[{
  GraphicsGrid[{top, bottom}, ImageSize -> 1000],
  Row[{
    LineLegend[{Directive[cOrange, Thick], Directive[cBrown, Thick, Dashed], \
Directive[Black, Thick]},
     {Subscript[\"\[Chi]\", \"geom\"], Subscript[\"\[Chi]\", \"mass\"],
      Row[{Subscript[\"\[Chi]\", \"e\"], \" = \", Subscript[\"\[Chi]\", \
\"geom\"], \" + \", Subscript[\"\[Chi]\", \"mass\"]}]},
     LegendLayout -> \"Row\"],
    SwatchLegend[{cShadeGeo, cShadeDisp}, {\"FM, geometry-driven\", \"FM, \
dispersion-driven\"},
     LegendLayout -> \"Row\"]}, Spacer[25]]},
 Alignment -> Center]\
\>", "Input",
 CellLabel->
  "In[100]:=",ExpressionUUID->"1b4c3209-bcb0-4d3f-b55e-4b5dc011788b"],

