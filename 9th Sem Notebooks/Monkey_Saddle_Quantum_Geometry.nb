Cell[CellGroupData[{

Cell["6.3 Temperature dependence at the saddle energy (Fig. 8b)", "Subsection",ExpressionUUID->"e2f90247-a711-44da-b5bd-72b029b45aab"],

Cell[CellGroupData[{

Cell["\<\
Tsing = Table[0.005 i, {i, 1, 20}];

singPlot[gp_] := Module[{s},
  s = Table[gesSing[gp, T, eSaddle[gp]], {T, Tsing}];
  ListLinePlot[Table[Transpose[{Tsing, s[[All, j]]}], {j, 3}],
   PlotMarkers -> {Automatic, 6},
   PlotStyle -> {Directive[cOrange, Thick], Directive[cBrown, Thick, Dashed], \
Directive[Black, Thick]},
   PlotRange -> All, Frame -> True, Axes -> False, GridLines -> {None, {0}},
   FrameLabel -> {\"T\", \"GES\"},
   PlotLabel -> Row[{\"\[CapitalDelta] = \", gp, \",  \[Mu] = \", \
Subscript[\"E\", \"s\"]}],
   PlotLegends -> Placed[{Subscript[\"\[Chi]\", \"geom\"], Subscript[\"\[Chi]\
\", \"mass\"],
      Row[{Subscript[\"\[Chi]\", \"e\"], \" = \", Subscript[\"\[Chi]\", \
\"geom\"], \" + \", Subscript[\"\[Chi]\", \"mass\"]}]},
     {Right, Bottom}],
   ImageSize -> 470]]

Row[{singPlot[0.17], singPlot[0.02]}]\
\>", "Input",
 CellLabel->
  "In[230]:=",ExpressionUUID->"97896cb5-d8c0-489d-81ca-ef232254e499"],

