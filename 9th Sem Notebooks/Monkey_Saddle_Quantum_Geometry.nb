Cell[CellGroupData[{

Cell["3. Quantum geometry of the critical band", "Section",ExpressionUUID->"a9805d0b-9915-4228-be64-329894ff9c46"],

Cell[TextData[{
 "The quantum geometric tensor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", 
     RowBox[{"\[Mu]", "\[Nu]"}]], " ", "=", " ", 
    SubscriptBox["g", 
     RowBox[{"\[Mu]", "\[Nu]"}]], " ", "-", " ", 
    FractionBox["i", "2"], " ", 
    SubscriptBox["\[CapitalOmega]", 
     RowBox[{"\[Mu]", "\[Nu]"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"09f5e66a-b672-4973-884f-67112ec28171"],
 " contains the quantum metric ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3ce6459e-ffaa-4af9-89a1-da8e7d03e37b"],
 " and the Berry curvature ",
 Cell[BoxData[
  FormBox["\[CapitalOmega]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2ad0b216-b3a2-4bb6-8efc-e296e459e7e1"],
 ". With constant velocity matrices both are finite sums:"
}], "Text",ExpressionUUID->"64dc104b-9e35-4c14-87e4-29283e2b98b7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["g", 
    RowBox[{"\[Mu]", "\[Nu]"}], "n"], " ", "=", " ", 
   SubscriptBox["\[Sum]", 
    RowBox[{"m", " ", "\[NotEqual]", " ", "n"}]], " ", 
   FractionBox[
    RowBox[{
     StyleBox["Re",
      FontSlant->"Plain"], "[", " ", 
     SubsuperscriptBox["v", 
      RowBox[{"n", "m"}], "\[Mu]"], " ", 
     SubsuperscriptBox["v", 
      RowBox[{"m", "n"}], "\[Nu]"], " ", "]"}], 
    RowBox[{"(", 
     SubscriptBox["\[CurlyEpsilon]", "n"], " ", "-", " ", 
     SubscriptBox["\[CurlyEpsilon]", "m"], 
     SuperscriptBox[")", "2"]}]], " ", ",", "   ", " ", 
   SubsuperscriptBox["\[CapitalOmega]", 
    RowBox[{"x", "y"}], "n"], " ", "=", " ", "-", "2", " ", 
   SubscriptBox["\[Sum]", 
    RowBox[{"m", " ", "\[NotEqual]", " ", "n"}]], " ", 
   FractionBox[
    RowBox[{
     StyleBox["Im",
      FontSlant->"Plain"], "[", " ", 
     SubsuperscriptBox["v", 
      RowBox[{"n", "m"}], "x"], " ", 
     SubsuperscriptBox["v", 
      RowBox[{"m", "n"}], "y"], " ", "]"}], 
    RowBox[{"(", 
     SubscriptBox["\[CurlyEpsilon]", "n"], " ", "-", " ", 
     SubscriptBox["\[CurlyEpsilon]", "m"], 
     SuperscriptBox[")", "2"]}]]}], TraditionalForm]], "DisplayFormula",Expres\
sionUUID->"81db4866-de81-42f4-b1a0-61009565f74e"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"34d57585-fec3-4efe-9f38-3539b764cdbe"],
 " only two channels contribute, the same two that compete in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "(", "V", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5635d536-b910-438b-a932-a40adeda1876"],
 ":"
}], "Text",ExpressionUUID->"d01409a3-c0d3-4cfb-91a1-30be8fe00065"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["g", 
    RowBox[{"x", "x"}]], " ", "=", " ", 
   SubscriptBox["g", 
    RowBox[{"y", "y"}]], " ", "=", " ", 
   FractionBox[
    SubsuperscriptBox["v", "3", "2"], 
    SuperscriptBox["V", "2"]], " ", "+", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox["v", "2"], " ", "(", 
     SubsuperscriptBox["\[Gamma]", "1", "2"], " ", "+", " ", 
     SuperscriptBox["V", "2"], ")"}], 
    SubsuperscriptBox["\[Gamma]", "1", "4"]], " ", ",", "   ", " ", 
   SubscriptBox["\[CapitalOmega]", 
    RowBox[{"x", "y"}]], " ", "=", " ", 
   FractionBox[
    RowBox[{"2", " ", 
     SubsuperscriptBox["v", "3", "2"]}], 
    SuperscriptBox["V", "2"]], " ", "-", " ", 
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["v", "2"], " ", "(", 
     SubsuperscriptBox["\[Gamma]", "1", "2"], " ", "+", " ", 
     SuperscriptBox["V", "2"], ")"}], 
    SubsuperscriptBox["\[Gamma]", "1", "4"]]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"37199bcd-3aa1-43de-\
8614-7dd1972e4eb1"],

Cell[TextData[{
 "The first term is the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ede6ea80-3074-435a-9e78-42161fbd08ba"],
 " channel, the second the dimer channel. They couple through ",
 Cell[BoxData[
  FormBox["\[Pi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f298a9b7-27ab-4f90-8821-a6a250120ecb"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Pi]", "\[Dagger]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"12563cec-a29a-4e70-9c90-997eb9b91d28"],
 ", so they carry ",
 StyleBox["opposite chirality",
  FontWeight->"Bold"],
 ": the metrics add, the Berry curvatures cancel."
}], "Text",ExpressionUUID->"15860bb4-74a0-45db-bb06-22967914dc01"],

Cell["\<\
(* g_xx and Omega_xy of band 3 from the sum over the other three bands *)
geometry[kx_, ky_, V_] := Module[{e, U, vx, vy, g = 0, om = 0},
  {e, U} = bands[kx, ky, V];
  vx = Conjugate[U].dHx.Transpose[U];
  vy = Conjugate[U].dHy.Transpose[U];
  Do[If[m != 3,
    g += Abs[vx[[3, m]]]^2/(e[[3]] - e[[m]])^2;
    om += -2 Im[vx[[3, m]] vy[[m, 3]]]/(e[[3]] - e[[m]])^2], {m, 4}];
  {g, om}]

gB2[V_] := v3^2/V^2
gDimer[V_] := v^2 (g1^2 + V^2)/g1^4
gClosed[V_] := gB2[V] + gDimer[V]
omClosed[V_] := 2 gB2[V] - 2 gDimer[V]\
\>", "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"3a098c59-492f-4d49-8922-7cee676afe7c"],

Cell[TextData[{
 StyleBox["Table II.",
  FontWeight->"Bold"],
 " Effective-mass coefficient and quantum geometry of band 3 at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b66673b5-a30c-4eed-b8ed-3b0160d7b7e1"],
 ": exact diagonalisation next to the closed forms."
}], "Text",ExpressionUUID->"8e445c0e-9f96-411e-addb-67aee805e69a"],

