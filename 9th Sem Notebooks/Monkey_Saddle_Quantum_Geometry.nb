  ExpressionUUID->"658ba36b-a8ca-46f3-8d87-f99a08cd756d"],
 ", and a close-up of band 3 for three biases. In the close-up the band \
bottom at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f7192301-9efb-489f-8616-bc5815537a6e"],
 " flattens at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", "c"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "edcf4928-d02f-4436-aeb6-f79289b2350c"],
 " and then turns into a maximum."
}], "Text",ExpressionUUID->"681155cc-6d86-405a-a0a2-28cf1196d3a0"],

Cell[CellGroupData[{

Cell["\<\
Plot[{band[1, k, 0, Vc], band[2, k, 0, Vc], band[3, k, 0, Vc], band[4, k, 0, \
Vc]}, {k, -1, 1},
 PlotStyle -> {Gray, Gray, Directive[cOrange, Thick], Gray},
 Frame -> True, FrameLabel -> {\"kx (1/nm)\", \"E (eV)\"},
 PlotLabel -> \"Four bands at V = Vc (band 3 in orange)\", ImageSize -> 450]\
\>", "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"219d179f-354c-4c1d-8a48-074fc8408c7a"],

