  FormBox[
   RowBox[{"\[Delta]", " ", "=", " ", "0.5"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b5da1b79-4412-4031-ad76-33eefad6b1b8"],
 StyleBox[" \[LongDash] minimum at ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"52eeaaa4-5d18-499e-8b65-a43e3d28998e"],
 " surrounded by three saddles on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[CurlyPhi]", " ", "=", " ", "0", ",", " ", "\[PlusMinus]", " ", "2", 
    "\[Pi]", "/", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f03479a6-0b04-40c7-90a3-c4f0fd9c3d0a"],
 "."
}], "Text",ExpressionUUID->"d1ca6550-28bf-41d0-a388-4925deb2d0da"],

