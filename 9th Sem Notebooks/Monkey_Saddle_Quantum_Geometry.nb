Cell[TextData[{
 StyleBox["The GES.",
  FontWeight->"Bold"],
 " With the band data stored, every ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[Mu]", ",", " ", "T", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"bd887a63-393c-45aa-b1ab-d33eb9ea7ab4"],
 " point is just a weighted sum. The Fermi function is written with Tanh so \
that it never overflows; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["f", "\[Prime]"], " ", "=", " ", "-", "f", "(", "1", "-", 
    "f", ")", "/", "T"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2121754c-4fd9-4ff6-a8af-3aa1829c83b2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["f", 
     RowBox[{"\[Prime]", "\[Prime]"}]], " ", "=", " ", "f", "(", "1", "-", 
    "f", ")", "(", "1", "-", "2", "f", ")", "/", 
    SuperscriptBox["T", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cad30bf1-dd91-4420-abd6-aef38e647745"],
 ". All four bands are kept with full Fermi functions."
}], "Text",ExpressionUUID->"2f435472-f5e0-4b00-a8ab-80b74f7fab48"],

Cell["\<\
(* returns {chi_geom, chi_mass, chi_e, chi0(q=0)};  dmu = mu - V/2 and T in \
meV *)
ges[del_, dmu_, T_] := Module[{en, gk, xs, ms, out, mu, t, f, fp, fpp, \
metric, shift, mass},
  {en, gk, xs, ms, out} = data[del];
  mu = del Vc/2 + 0.001 dmu;
  t = 0.001 T;
  f = (1 - Tanh[(en - mu)/(2 t)])/2;
  fp = -f (1 - f)/t;
  fpp = f (1 - f) (1 - 2 f)/t^2;
  metric = 2 ws.Total[fp gk/2, {2}];
  shift = 2 ws.Total[f xs, {2}] + out;
  mass = -2 ws.Total[fpp ms/12, {2}];
  {metric + shift, mass, metric + shift + mass, ws.Total[-fp, {2}]}]\
\>", "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"76780b0c-36a7-48bd-9cee-ccc7301ee152"],

