Cell[CellGroupData[{

Cell["6.2 GES of the two-band model", "Subsection",ExpressionUUID->"778fb693-e7a9-4d5c-913c-488078d45dff"],

Cell[TextData[{
 "For two bands everything is analytic. With ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "01460e7c-1c6f-4269-a31d-b6a79070f749"],
 " the vector multiplying the Pauli matrices and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "=", " ", "h", "/", "|", "h", "|"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"baad1257-4fab-4457-948f-b83979bebc80"],
 ": the metric is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"\[Mu]", "\[Nu]"}]], " ", "=", " ", 
    SubscriptBox["\[PartialD]", "\[Mu]"], " ", "n", " ", "\[CenterDot]", " ", 
    SubscriptBox["\[PartialD]", "\[Nu]"], " ", "n", " ", "/", " ", "4"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "15b5d401-eb7c-4099-9517-e7b2d9e9c389"],
 " for both bands, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "K"], " ", "=", " ", 
    SubscriptBox["g", 
     RowBox[{"x", "x"}]], " ", "+", " ", 
    SubscriptBox["g", 
     RowBox[{"y", "y"}]]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a1770e2c-d9d2-451b-913c-4431b1b64784"],
 "; the Fermi-sea term is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", " ", "=", " ", "\[PlusMinus]", " ", 
    SubscriptBox["g", "K"], " ", "/", " ", "2", "|", "h", "|"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab2bc970-7c38-467d-b510-a46abc040eb2"],
 " (plus for the lower band); the inverse mass is half the Laplacian of the \
band energy. Mathematica takes the derivatives symbolically, then the \
expressions are evaluated on a polar grid over one quadrant with the momentum \
cutoff ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "p", "|", " ", "\[LessEqual]", " ", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"95c5110b-9156-4d5a-8ce2-6f9d09e3977d"],
 "."
}], "Text",ExpressionUUID->"62169830-5cf4-475e-a664-f0705fac4b32"],

Cell[CellGroupData[{

Cell["\<\
hvec = {pars[[3]] px py, gap, pars[[2]] (px^2 - py^2)/2};
hn = Sqrt[hvec.hvec];
nvec = hvec/hn;

eUp = eSing[1, px, py, gap];
eDn = eSing[-1, px, py, gap];

gKs = (D[nvec, px].D[nvec, px] + D[nvec, py].D[nvec, py])/4;
mUp = (D[eUp, {px, 2}] + D[eUp, {py, 2}])/2;
mDn = (D[eDn, {px, 2}] + D[eDn, {py, 2}])/2;

Simplify[gKs /. gap -> 0]       (* the metric at band touching: diverges as \
1/p^2 *)\
\>", "Input",
 CellLabel->
  "In[208]:=",ExpressionUUID->"31806ecc-3824-4ca6-85c8-0f9601a66bb1"],

Cell[BoxData[
 FractionBox[
  RowBox[{"9", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["px", "2"], "+", 
      SuperscriptBox["py", "2"]}], ")"}], "3"]}], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["px", "4"], "+", 
     RowBox[{"34", " ", 
      SuperscriptBox["px", "2"], " ", 
      SuperscriptBox["py", "2"]}], "+", 
     SuperscriptBox["py", "4"]}], ")"}], "2"]]], "Output",
 CellChangeTimes->{4.003672648852878*^9},
 CellLabel->
  "Out[219]=",ExpressionUUID->"e52e4271-9a40-4e89-a165-4d521a9d8a4d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
(* quadrant grid, 24 radial panels, 96 angles, cutoff |p| <= 1 *)
{pxs, pys, wps} = polarGrid[Table[i/24., {i, 0, 24}], 96, Pi/2];

(* band energies, masses, metric and |h| on the grid, stored for each gap *)
sing[gp_] := sing[gp] = ({eDn, eUp, mDn, mUp, gKs, hn} /. {px -> pxs, py -> \
pys, gap -> gp})

(* returns {chi_geom, chi_mass, chi_e} in model units *)
gesSing[gp_, T_, mu_] := Module[{ed, eu, md, mup, g, h, f, fp, fpp, geom = 0, \
mass = 0},
  {ed, eu, md, mup, g, h} = sing[gp];
  Do[
   f = (1 - Tanh[(b[[1]] - mu)/(2 T)])/2;
   fp = -f (1 - f)/T;
   fpp = f (1 - f) (1 - 2 f)/T^2;
   geom += 2 wps.(fp g/2 + f b[[3]]);
   mass += -2 wps.(fpp b[[2]]/12),
   {b, {{ed, md, g/(2 h)}, {eu, mup, -g/(2 h)}}}];
  {geom, mass, geom + mass}]

gesSing[0.17, 0.005, eSaddle[0.17]]     (* about {-0.73, 0.81, 0.09} *)\
\>", "Input",
 CellLabel->
  "In[220]:=",ExpressionUUID->"d8b594a2-d1a3-470c-b6d2-f9cb408f2b01"],

