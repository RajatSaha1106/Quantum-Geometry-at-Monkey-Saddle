Cell[TextData[{
 StyleBox["Tail.",
  FontWeight->"Bold"],
 " Beyond ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.6", " ", 
    SuperscriptBox[
     StyleBox[
      RowBox[{" ", "nm"}],
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "176b8107-1466-4791-b342-189d0f58dde3"],
 " there is no Fermi surface for the ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5e8ebf9a-4a01-4f2a-a548-a2ceb055cca6"],
 " and ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "880b25b5-45c2-4ae4-b1b6-e0924d7c2f6e"],
 " used here, so only the Fermi-sea term of the two filled valence bands \
survives. It decays slowly, so we integrate it on logarithmic panels up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", 
     StyleBox["max",
      FontSlant->"Plain"]], " ", "=", " ", "20"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c18b1230-0d4d-48f8-82f8-6488d84a1f60"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"80", " ", 
    SuperscriptBox[
     StyleBox[
      RowBox[{" ", "nm"}],
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "75a920a6-7ab8-4df3-890f-ac4f8b17cead"],
 " and extrapolate linearly in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SubscriptBox["k", 
     StyleBox["max",
      FontSlant->"Plain"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9cfc1a18-ba3f-4a66-b750-1f5237ff4bd7"],
 "."
}], "Text",ExpressionUUID->"5e13f7a3-84f4-45d2-b2ed-6eab8d44cc34"],

Cell["\<\
tail[V_, kmax_] := Module[{ed, kx, ky, w, xx},
  ed = Table[0.6 (kmax/0.6)^(i/16.), {i, 0, 16}];
  {kx, ky, w} = polarGrid[ed, 8, Pi/3];
  xx = Table[bandData[kx[[i]], ky[[i]], V][[3]], {i, Length[kx]}];
  2 w.(xx[[All, 1]] + xx[[All, 2]])]

prepare[del_] := Module[{V = del Vc, dat, out},
  dat = Table[bandData[kxs[[i]], kys[[i]], V], {i, Length[kxs]}];
  dat = Developer`ToPackedArray[dat];      (* packed storage keeps the later \
sums fast *)
  out = (80 tail[V, 80.] - 20 tail[V, 20.])/60;
  {dat[[All, 1]], dat[[All, 2]], dat[[All, 3]], dat[[All, 4]], out}]\
\>", "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"52c6369e-66c3-49bc-ac6c-6d9380129c2b"],

Cell[TextData[{
 "Now tabulate the band data once for each bias used in the talk. ",
 StyleBox["This is the slow cell",
  FontWeight->"Bold"],
 " (about 50 000 diagonalisations per bias)."
}], "Text",ExpressionUUID->"b19eb1c9-051c-40f7-993b-ef62d6e8e13b"],

Cell[CellGroupData[{

Cell["\<\
(* slow cell: expect something like 10 to 60 seconds per bias *)
AbsoluteTiming[
 Do[data[del] = prepare[del], {del, {0.5, 0.8, 1.0, 1.2, 1.5}}]]\
\>", "Input",
 CellLabel->"In[91]:=",ExpressionUUID->"d763359a-c172-4b67-bd1c-65e46af2bd57"],

