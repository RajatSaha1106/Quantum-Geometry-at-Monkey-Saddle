Cell[CellGroupData[{

Cell["2.3 Critical points (Table I)", "Subsection",ExpressionUUID->"6c6f9f14-e16d-4718-9418-4e55c567ee1a"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "(", 
    SubscriptBox["k", "x"], ",", " ", "-", 
    SubscriptBox["k", "y"], ")", " ", "=", " ", "H", "(", 
    SubscriptBox["k", "x"], ",", " ", 
    SubscriptBox["k", "y"], 
    SuperscriptBox[")", "*"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"65be6d6a-38c3-4c5f-9e22-c5a17ed55c15"],
 ", band 3 is even in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "y"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "28c6de03-7a4f-45a3-b3f1-934c896244e6"],
 ". Every zero of the slope ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PartialD]", " ", 
    SubscriptBox["\[CurlyEpsilon]", "3"], "/", "\[PartialD]", " ", 
    SubscriptBox["k", "x"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"70c6bccf-befc-4ac7-82e7-c48b1990c909"],
 " on the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "x"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "06b0c52b-213d-4eaa-9250-645795f86e72"],
 " axis is therefore a true critical point. The negative axis is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyPhi]", " ", "=", " ", "\[Pi]", "/", "3"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f7bdf962-a8a6-4772-bb5d-5211aabd63e2"],
 " mirror line up to a ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "00e1788b-edc5-4c92-af47-980606f6ec39"],
 " rotation, so one scan of the axis finds everything. The slope is the \
Hellmann\[Dash]Feynman expectation value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", " ", "3", "|", " ", 
    SubscriptBox["\[PartialD]", "x"], " ", "H", " ", "|", "3", " ", 
    "\[RightAngleBracket]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2fa8d1d0-ebc4-4297-b5e9-de8b71bee0ec"],
 "; sign changes are bracketed on a grid and refined by bisection. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", "=", " ", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5e39cbdf-ab48-4421-b570-0fc8d55d3494"],
 " is always a critical point by symmetry."
}], "Text",ExpressionUUID->"d04790ae-7e9d-4ac8-9eaa-4a9a6c0493a8"],

Cell[CellGroupData[{

Cell["\<\
slope[k_?NumericQ, V_] := Module[{u = bands[k, 0, V][[2, 3]]},
  Re[Conjugate[u].dHx.u]]

(* zero of the slope between a0 and b0 by bisection *)
bisect[V_, a0_, b0_] := Module[{a = a0, b = b0, c},
  Do[c = (a + b)/2;
   If[slope[a, V] slope[c, V] <= 0, b = c, a = c], {40}];
  (a + b)/2]

criticalK[V_] := Module[{kk, s, roots = {}},
  kk = Table[(-1.605 + 0.01 i) ks, {i, 0, 320}];
  s = Table[slope[k, V], {k, kk}];
  Do[If[s[[i]] s[[i + 1]] < 0, AppendTo[roots, bisect[V, kk[[i]], kk[[i + \
1]]]]],
   {i, Length[kk] - 1}];
  Prepend[Select[roots, Abs[#] > 0.001 ks &], 0.]]

criticalK[0.5 Vc]/ks\
\>", "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"85a1a29c-5b31-49fb-b717-ae7738d40bed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.`", ",", "0.15836771044474066`", ",", "0.5897894148864591`"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0036722965198407`*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"ee48c1de-fb42-4316-8c23-8baa6194d4b3"]
}, Open  ]],

Cell[TextData[{
 "Each point is classified by the exact Hessian of band 3. For a Hamiltonian \
linear in ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7ddc41fe-45a9-45dd-9cbe-0c25b3657130"],
 ":"
}], "Text",ExpressionUUID->"d8c05f2a-58fc-4034-baa9-ce0d23aab858"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
   SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
   SubscriptBox["\[CurlyEpsilon]", "n"], " ", "=", " ", 
   SubscriptBox["\[Sum]", 
    RowBox[{"m", " ", "\[NotEqual]", " ", "n"}]], " ", 
   FractionBox[
    RowBox[{"2", " ", 
     StyleBox["Re",
      FontSlant->"Plain"], "[", " ", 
     SubsuperscriptBox["v", 
      RowBox[{"n", "m"}], "\[Mu]"], " ", 
     SubsuperscriptBox["v", 
      RowBox[{"m", "n"}], "\[Nu]"], " ", "]"}], 
    RowBox[{
     SubscriptBox["\[CurlyEpsilon]", "n"], " ", "-", " ", 
     SubscriptBox["\[CurlyEpsilon]", "m"]}]], " ", ",", "   ", " ", 
   SubsuperscriptBox["v", 
    RowBox[{"n", "m"}], "\[Mu]"], " ", "=", " ", "\[LeftAngleBracket]", " ", 
   "n", "|", " ", 
   SubscriptBox["\[PartialD]", "\[Mu]"], " ", "H", " ", "|", "m", " ", 
   "\[RightAngleBracket]"}], TraditionalForm]], "DisplayFormula",ExpressionUUI\
D->"3c6cc119-0704-4033-b9fe-738254aa0f70"],

Cell["\<\
hessian[kx_, ky_, V_] := Module[{e, U, vx, vy, hxx = 0, hyy = 0, hxy = 0},
  {e, U} = bands[kx, ky, V];
  vx = Conjugate[U].dHx.Transpose[U];      (* vx[[n, m]] = <n| dH/dkx |m> *)
  vy = Conjugate[U].dHy.Transpose[U];
  Do[If[m != 3,
    hxx += 2 Abs[vx[[3, m]]]^2/(e[[3]] - e[[m]]);
    hyy += 2 Abs[vy[[3, m]]]^2/(e[[3]] - e[[m]]);
    hxy += 2 Re[vx[[3, m]] vy[[m, 3]]]/(e[[3]] - e[[m]])], {m, 4}];
  {{hxx, hxy}, {hxy, hyy}}]

kind[h_] := Module[{ev = Eigenvalues[h]},
  Which[Max[Abs[ev]] < 10^-6, \"monkey saddle\",
   Min[ev] > 0, \"minimum\",
   Max[ev] < 0, \"maximum\",
   True, \"saddle\"]]\
\>", "Input",ExpressionUUID->"e948b2c3-63b7-4e77-81a9-c0a49cf4e168"],

Cell[CellGroupData[{

Cell["\<\
tableI = Flatten[
   Table[
    Table[{del, k/ks, 1000 (eps3[k, 0, del Vc] - del Vc/2),
      Chop[Sort[Eigenvalues[hessian[k, 0, del Vc]]], 10^-8], kind[hessian[k, \
0, del Vc]]},
     {k, criticalK[del Vc]}],
    {del, {0.5, 1.0, 1.5}}], 1];

Grid[Prepend[tableI, {\"\[Delta]\", \"kx/k*\", \"E - V/2 (meV)\", \"Hessian \
eigenvalues (eV nm^2)\", \"type\"}],
 Frame -> All, Alignment -> Left]\
\>", "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"7c3ea0f8-1fc6-4412-b574-694817244012"],

